// Ensure filterOrder includes all user filters (called after user adds/removes)
function syncFilterOrder() {
  // Collect existing user indices in filterOrder
  const existingUserIdxs = new Set(
    filterOrder.filter(e => e.type === 'user').map(e => e.idx)
  );
  // Add any new user filters not yet in the order
  resourceFiles.luaFilters.forEach((_, i) => {
    if (!existingUserIdxs.has(i)) {
      filterOrder.push({ type: 'user', idx: i });
    }
  });
  // Remove user entries whose idx is out of range (deleted filters)
  filterOrder = filterOrder.filter(e => {
    if (e.type === 'builtin') return true;
    return e.idx >= 0 && e.idx < resourceFiles.luaFilters.length;
  });
  // Ensure all built-ins are present
  const existingBuiltinIds = new Set(
    filterOrder.filter(e => e.type === 'builtin').map(e => e.id)
  );
  BUILT_IN_FILTERS.forEach(f => {
    if (!existingBuiltinIds.has(f.id)) {
      filterOrder.unshift({ type: 'builtin', id: f.id });
    }
  });
}

// Move a filter in the order array and re-render
function moveFilter(fromIdx, toIdx) {
  if (toIdx < 0 || toIdx >= filterOrder.length) return;
  const [moved] = filterOrder.splice(fromIdx, 1);
  filterOrder.splice(toIdx, 0, moved);
  renderLuaFiltersList();
}

function renderLuaFiltersList() {
  const list = document.getElementById('luaFiltersList');
  if (!list) return;
  syncFilterOrder();

  // If nothing to show, clear
  if (filterOrder.length === 0) { list.innerHTML = ''; return; }

  list.innerHTML = '';
  filterOrder.forEach((entry, orderIdx) => {
    const tag = document.createElement('span');
    tag.draggable = true;
    tag.dataset.orderIdx = orderIdx;
    tag.style.cursor = 'grab';

    // Determine display name and enabled state for both filter types
    let filterName = '';
    let isEnabled = true;

    if (entry.type === 'builtin') {
      const def = BUILT_IN_FILTERS.find(f => f.id === entry.id);
      if (!def) return;
      filterName = def.name;
      isEnabled = builtInState[entry.id];
      tag.className = 'opt-file-tag builtin-filter' + (isEnabled ? ' enabled' : '');
      tag.title = def.description;
      tag.innerHTML = `<span style="color:var(--text-muted);font-size:12px;margin-right:2px;" aria-hidden="true">☰</span>` +
        `<input type="checkbox" class="builtin-checkbox" ${isEnabled ? 'checked' : ''} aria-label="Enable ${def.name} filter">` +
        `${def.name}<span class="builtin-label">(built-in)</span>`;
      tag.querySelector('.builtin-checkbox').addEventListener('change', (ev) => {
        ev.stopPropagation();
        builtInState[entry.id] = ev.target.checked;
        renderLuaFiltersList();
      });
    } else {
      const f = resourceFiles.luaFilters[entry.idx];
      if (!f) return;
      filterName = f.name;
      // Default to enabled if no state recorded
      if (userFilterState[entry.idx] === undefined) userFilterState[entry.idx] = true;
      isEnabled = userFilterState[entry.idx];
      tag.className = 'opt-file-tag' + (isEnabled ? '' : ' builtin-filter');
      tag.innerHTML = `<span style="color:var(--text-muted);font-size:12px;margin-right:2px;" aria-hidden="true">☰</span>` +
        `<input type="checkbox" class="builtin-checkbox" ${isEnabled ? 'checked' : ''} aria-label="Enable ${f.name} filter">` +
        `${f.name}<button class="file-remove" data-useridx="${entry.idx}" aria-label="Remove ${f.name}">×</button>`;
      // Checkbox toggle for user filter
      tag.querySelector('.builtin-checkbox').addEventListener('change', (ev) => {
        ev.stopPropagation();
        userFilterState[entry.idx] = ev.target.checked;
        renderLuaFiltersList();
      });
      // Remove button
      tag.querySelector('.file-remove').addEventListener('click', (ev) => {
        ev.stopPropagation();
        const removedIdx = entry.idx;
        resourceFiles.luaFilters.splice(removedIdx, 1);
        // Clean up userFilterState and adjust indices
        delete userFilterState[removedIdx];
        const newState = {};
        for (const [k, v] of Object.entries(userFilterState)) {
          const ki = parseInt(k);
          if (ki > removedIdx) newState[ki - 1] = v;
          else if (ki < removedIdx) newState[ki] = v;
        }
        Object.keys(userFilterState).forEach(k => delete userFilterState[k]);
        Object.assign(userFilterState, newState);
        // Remove from filterOrder and adjust indices
        filterOrder = filterOrder.filter(e => !(e.type === 'user' && e.idx === removedIdx));
        filterOrder.forEach(e => {
          if (e.type === 'user' && e.idx > removedIdx) e.idx--;
        });
        renderLuaFiltersList();
      });
    }

    // Keyboard-accessible reorder buttons (right-justified)
    const arrowWrap = document.createElement('span');
    arrowWrap.className = 'filter-reorder-wrap';

    const btnUp = document.createElement('button');
    btnUp.className = 'filter-reorder-btn';
    btnUp.textContent = '↑';
    btnUp.setAttribute('aria-label', `Move ${filterName} up`);
    btnUp.addEventListener('click', (ev) => { ev.stopPropagation(); moveFilter(orderIdx, orderIdx - 1); });
    arrowWrap.appendChild(btnUp);

    const btnDown = document.createElement('button');
    btnDown.className = 'filter-reorder-btn';
    btnDown.textContent = '↓';
    btnDown.setAttribute('aria-label', `Move ${filterName} down`);
    btnDown.addEventListener('click', (ev) => { ev.stopPropagation(); moveFilter(orderIdx, orderIdx + 1); });
    arrowWrap.appendChild(btnDown);

    tag.appendChild(arrowWrap);

    // Drag events for reordering (unified)
    tag.addEventListener('dragstart', (e) => {
      e.dataTransfer.setData('text/plain', orderIdx);
      tag.style.opacity = '0.4';
    });
    tag.addEventListener('dragend', () => { tag.style.opacity = '1'; });
    tag.addEventListener('dragover', (e) => {
      e.preventDefault();
      tag.style.borderColor = 'var(--accent)';
    });
    tag.addEventListener('dragleave', () => { tag.style.borderColor = ''; });
    tag.addEventListener('drop', (e) => {
      e.preventDefault();
      tag.style.borderColor = '';
      const fromIdx = parseInt(e.dataTransfer.getData('text/plain'));
      const toIdx = parseInt(tag.dataset.orderIdx);
      if (fromIdx !== toIdx) {
        moveFilter(fromIdx, toIdx);
      }
    });

    list.appendChild(tag);
  });
}


  .status-dot.loading { background: #ffc107; animation: pulse 1.2s infinite; }
  .status-dot.error { background: #ef5350; }

  @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }

  /* ─── CENTER WRAP ─── */
  .center-wrap { flex: 1; display: flex; overflow: hidden; }
  .center-wrap.vertical { flex-direction: column; }

  /* ─── HIDDEN FILE INPUT ─── */
  #fileInput { display: none; }

  /* Scrollbar */
  ::-webkit-scrollbar { width: 8px; height: 8px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb { background: #c0c0c0; border-radius: 4px; }
  ::-webkit-scrollbar-thumb:hover { background: #999; }

  /* ─── OPTIONS PANEL ─── */
  .options-panel {
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border);
    overflow: hidden;
    transition: max-height 0.25s ease;
  }
  .options-panel.collapsed { max-height: 0 !important; border-bottom: none; }

  .options-tabs {
    display: flex;
    gap: 0;
    border-bottom: 1px solid var(--border);
    padding: 0 8px;
    overflow-x: auto;
    flex-shrink: 0;
  }
  .options-tab {
    padding: 5px 10px;
    font-size: 13px;
    font-family: var(--font-ui);
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    color: var(--text-muted);
    cursor: pointer;
    white-space: nowrap;
    transition: color 0.15s, border-color 0.15s;
  }
  .options-tab:hover { color: var(--text-primary); background: rgba(0,0,0,0.03); }
  .options-tab.active { color: var(--accent); border-bottom-color: var(--accent); font-weight: 600; }

  .options-tab-panel {
    display: none;
    padding: 8px 12px;
    gap: 8px;
  }
  .options-tab-panel.active { display: flex; flex-wrap: wrap; align-items: flex-start; }

  .options-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 18px;
    align-items: center;
  }

  .opt-group {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 13px;
    font-family: var(--font-ui);
    color: var(--text-secondary);
  }
  .opt-group label { white-space: nowrap; cursor: pointer; }
  .opt-group input[type="checkbox"] { width: 14px; height: 14px; accent-color: var(--accent); cursor: pointer; }
  .opt-group select, .opt-group input[type="text"], .opt-group input[type="number"] {
    background: var(--bg-primary);
    color: var(--text-primary);
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 3px 6px;
    font-size: 13px;
    font-family: var(--font-mono);
  }
  .opt-group select { padding-right: 18px; }
  .opt-group select:focus, .opt-group input:focus { outline: 1px solid var(--accent); border-color: var(--accent); }

  .opt-section-label {
    font-size: 12px;
    font-family: var(--font-ui);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-right: 4px;
  }

  /* File upload areas within options */
  .opt-file-upload {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-family: var(--font-ui);
    color: var(--text-secondary);
  }
  .opt-file-upload .upload-btn {
    padding: 3px 8px;
    font-size: 12px;
    background: var(--bg-primary);
    color: var(--text-secondary);
    border: 1px solid var(--border);
    border-radius: 3px;
    cursor: pointer;
    font-family: var(--font-ui);
  }
  .opt-file-upload .upload-btn:hover { background: var(--bg-hover); color: var(--text-primary); }
  .opt-file-upload .file-name {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--accent);
    max-width: 200px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .opt-file-upload .file-remove {
    background: none;
    border: none;
    color: var(--error);
    cursor: pointer;
    font-size: 13px;
    padding: 0 2px;
    line-height: 1;
  }
  .opt-file-list {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: 3px;
  }
  .opt-file-tag {
    display: flex;
    align-items: center;
    gap: 3px;
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 2px 6px;
    font-size: 12px;
    font-family: var(--font-mono);
    color: var(--accent);
  }
  .opt-file-tag .file-remove { font-size: 12px; }

  /* Built-in filter tag variant */
  .opt-file-tag.builtin-filter {
    color: var(--text-secondary);
    border-style: dashed;
  }
  .opt-file-tag.builtin-filter.enabled {
    color: var(--accent);
    border-style: solid;
  }
  .opt-file-tag .builtin-checkbox {
    width: 12px;
    height: 12px;
    accent-color: var(--accent);
    cursor: pointer;
    margin: 0;
  }
  .opt-file-tag .builtin-label {
    font-size: 11px;
    color: var(--text-muted);
    margin-left: 2px;
  }

  /* Key/value row for metadata and variables */
  .opt-kv-row {
    display: flex;
    gap: 4px;
    align-items: center;
    margin-bottom: 3px;
  }
  .opt-kv-row input[type="text"] {
    background: var(--bg-primary);
    color: var(--text-primary);
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 3px 6px;
    font-size: 13px;
    font-family: var(--font-mono);
    width: 140px;
  }
  .opt-kv-row input:focus { outline: 1px solid var(--accent); border-color: var(--accent); }
  .opt-kv-row .kv-remove {
    background: none;
    border: none;
    color: var(--error);
    cursor: pointer;
    font-size: 13px;
    padding: 0 2px;
    line-height: 1;
    visibility: hidden;
  }
  .opt-kv-row:hover .kv-remove { visibility: visible; }

  /* Collapsible format-specific sections */
  details.fmt-section {
    margin-top: 6px;
    border: 1px solid var(--border-subtle);
    border-radius: 4px;
    overflow: hidden;
  }
  details.fmt-section > summary {
    text-transform: uppercase;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    padding: 5px 8px;
    cursor: pointer;
    background: var(--bg-tertiary);
    user-select: none;
    list-style: none;
  }
  details.fmt-section > summary::-webkit-details-marker { display: none; }
  details.fmt-section > summary::before {
    content: '▸ ';
    font-size: 10px;
  }
  details.fmt-section[open] > summary::before {
    content: '▾ ';
  }
  details.fmt-section[open] > summary {
    color: var(--text-secondary);
    border-bottom: 1px solid var(--border-subtle);
  }
  details.fmt-section > .fmt-section-body {
    padding: 6px 8px;
  }

  /* Extension checkbox items */
  .ext-item {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 2px 4px;
    font-size: 12px;
    font-family: var(--font-mono);
    color: var(--text-secondary);
    border-radius: 2px;
  }
  .ext-item:hover { background: var(--bg-tertiary); }
  .ext-item input[type="checkbox"] { width: 13px; height: 13px; accent-color: var(--accent); cursor: pointer; }
  .ext-item label { cursor: pointer; white-space: nowrap; }
  .ext-item.default-on label { font-weight: 500; }
  .ext-item.toggled label { color: var(--accent); }

  /* Filter reorder buttons */
  /* Filter list: tags should stretch full width for arrow alignment */
  #luaFiltersList { display: flex; flex-direction: column; gap: 4px; }
  #luaFiltersList .opt-file-tag { width: 100%; }

  .filter-reorder-wrap {
    display: flex;
    gap: 2px;
    margin-left: auto;
    flex-shrink: 0;
  }
  .filter-reorder-btn {
    background: none;
    border: 1px solid transparent;
    color: var(--text-muted);
    font-size: 13px;
    line-height: 1;
    padding: 1px 3px;
    cursor: pointer;
    border-radius: 2px;
    flex-shrink: 0;
  }
  .filter-reorder-btn:hover { color: var(--text-primary); background: var(--bg-tertiary); border-color: var(--border); }
  .filter-reorder-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: -1px; }

  .toolbar-link {
    align-self: center; font-size: 12px; color: var(--text-muted);
    text-decoration: underline; margin-left: 4px; white-space: nowrap;
  }
  .toolbar-link:hover, .toolbar-link:focus-visible { color: var(--text-primary); }
  /* Toggle button in toolbar for options panel */
  .toolbar-btn.options-toggle.panel-open { color: var(--accent); }

  /* Harvard accent borders on bottom-mode output */
  .output-panel.bottom-mode {
    border-left: none;
    border-top: 3px solid var(--harvard-blue);
  }
</style>
</head>

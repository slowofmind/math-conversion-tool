document.getElementById('btnConvert').addEventListener('click', () => {
  if (activeEngine === 'pandoc') {
    runConversion();
  } else if (activeEngine === 'latexml') {
    runLatexmlConversion();
  } else if (activeEngine === 'lualatex') {
    runLualatexCompilation();
  }
});

async function runConversion() {
  if (!pandocModule) return;

  // Restore iframe sandbox in case previous output was a PDF
  restoreHtmlPreview();

  const btn = document.getElementById('btnConvert');
  btn.disabled = true;
  btn.textContent = 'Converting…';
  updateStatus('loading', 'Converting…');
  clearDecorations();

  const sourceText = inputBinaryFile ? null : getSourceForConversion();

  try {
    if (isThoriumPreset()) { updateStatus('loading', 'Loading Thorium EPUB assets…'); await ensureThoriumAssets(); }
    if (needsIntentFilter()) { updateStatus('loading', 'Loading intent/SRE filter…'); await ensureIntentFilter(); }

    const options = buildOptions();
    const files = buildFiles();
    const outFileName = options['output-file'];
    const baseToFmt = document.getElementById('selTo').value.split(/[+-]/)[0];
    const isBinaryOutput = BINARY_FORMATS.includes(baseToFmt);

    console.log('Pandoc options:', JSON.stringify(options, null, 2));

    // Load the MathJax device (once) before converting, if a MathJax device mode is active.
    if (needsMathjaxDevice()) { updateStatus('loading', 'Loading math engine…'); await ensureMathjaxDevice(); }

    // Retry loop for missing resources (up to 20 retries)
    let result;
    const placeholderFiles = [];
    const MAX_RETRIES = 20;

    for (let attempt = 0; attempt <= MAX_RETRIES; attempt++) {
      try {
        result = await pandocModule.convert(options, sourceText, files);
        if (attempt > 0) console.log(`Conversion succeeded after ${attempt} placeholder(s)`);
        break; // success
      } catch (convErr) {
        console.warn(`Conversion attempt ${attempt} failed:`, convErr.message);
        const missingFile = extractMissingFile(convErr.message);
        if (missingFile && attempt < MAX_RETRIES) {
          // Add visible placeholder image and retry
          console.warn(`Missing resource "${missingFile}" — substituting placeholder`);
          files[missingFile] = await generatePlaceholderImage(missingFile);
          placeholderFiles.push(missingFile);
          continue;
        }
        throw convErr; // re-throw if not a missing file error or max retries
      }
    }

    // Check stderr for missing resource warnings (even if conversion succeeded)
    if (result.stderr) {
      const missingMatches = [...result.stderr.matchAll(/File\s+(\S+)\s+not found in resource path/gi)];
      for (const m of missingMatches) {
        if (!placeholderFiles.includes(m[1])) {
          placeholderFiles.push(m[1]);
        }
      }
    }

    // Parse warnings
    const warnings = parseWarnings(result.warnings, result.stderr, sourceText || '');

    // Cleanup-on-convert ran over a copy of the source, so warning line
    // numbers refer to the cleaned text, not the editor content.
    if (lastCleanupReplacements > 0) {
      warnings.unshift({
        line: null, column: null, level: 'warn',
        message: 'Cleanup was applied before conversion (' + lastCleanupReplacements +
          ' replacement' + (lastCleanupReplacements === 1 ? '' : 's') +
          ') — line numbers listed may not match line numbers in the original.',
        matchedText: null, type: 'cleanup'
      });
    }

    // Add placeholder warnings
    for (const pf of placeholderFiles) {
      warnings.push({
        line: null, column: null, level: 'warn',
        message: `Missing image "${pf}" — replaced with 1×1 transparent placeholder. Upload the actual image via the Media tab to include it.`,
        matchedText: null, type: 'placeholder'
      });
    }

    // Apply editor decorations (only for text input)
    if (!inputBinaryFile) applyDecorations(warnings);

    // Update log panel
    updateLog(warnings, result.stderr);

    // Handle output
    const downloadBtn = document.getElementById('btnDownloadOutput');
    const scormBtn = document.getElementById('btnDownloadScorm');

    if (isBinaryOutput && files[outFileName]) {
      // Binary output — show info in editor/preview, enable download
      let blob = files[outFileName];
      let outName = outFileName;

      // ---- Pandoc EPUB writer repair -------------------------------------
      // Pandoc's EPUB writer drops empty attribute VALUES from raw HTML
      // (verified on local Pandoc 3.10 CLI as well as wasm), producing
      //     <mrow ... ext-close data-latex="...">
      // which is invalid XHTML. Readers stop rendering at the first one.
      // html5 and chunkedhtml are unaffected — EPUB only.
      // Runs for every EPUB, before the Thorium splice.
      // Flag-don't-fail: on error keep the unrepaired EPUB and warn.
      if (isEpubFamily(baseToFmt)) {
        try {
          const fixed = await repairEpubEmptyAttributes(
            new Uint8Array(await blob.arrayBuffer()));
          if (fixed.changed) {
            blob = new Blob([fixed.data], { type: 'application/epub+zip' });
            console.log('EPUB attribute repair: ' + fixed.changed +
                        ' valueless attribute(s) fixed in ' +
                        fixed.docs + ' document(s)');
          }
        } catch (e) {
          console.warn('EPUB attribute repair failed; keeping EPUB as-is:', e);
        }
      }

      // EPUB for Thorium Reader — splice the MathJax payload into the EPUB.
      // Flag-don't-fail: on any error keep the plain EPUB and warn in the console.
      if (isThoriumPreset()) {
        try {
          updateStatus('loading', 'Adding MathJax payload to EPUB…');
          const epubBytes = new Uint8Array(await blob.arrayBuffer());
          const res = await processEpub(epubBytes, thoriumAssets.payloadBytes, { JSZip: window.JSZip });
          blob = new Blob([res.data], { type: 'application/epub+zip' });
          outName = outFileName.replace(/\.epub$/i, '') + '-thorium.epub';
          console.log('Thorium EPUB post-process:', res.stats);
        } catch (e) {
          console.warn('Thorium EPUB post-process failed; keeping plain EPUB:', e);
        }
      }

      const sizeKB = (blob.size / 1024).toFixed(1);

      lastOutput = { blob, filename: outName };
      downloadBtn.textContent = `📥 ${outName} (${sizeKB} KB)`;
      downloadBtn.style.display = '';
      scormBtn.style.display = 'none';

      sourceEditor.setText(`[Binary output: ${outName} (${sizeKB} KB)]\nUse the download button to save this file.`);

      const previewFrame = document.getElementById('previewFrame');
      previewFrame.srcdoc = `<body style="background:#f5f5f5;color:#1e2124;font-family:sans-serif;display:flex;align-items:center;justify-content:center;height:100vh;margin:0;flex-direction:column;">
        <div style="font-size:48px;margin-bottom:16px;">📄</div>
        <div style="font-size:16px;">${outName} (${sizeKB} KB)</div>
        <div style="font-size:12px;color:#666666;margin-top:8px;">Binary file — use the download button above</div>
        ${placeholderFiles.length > 0 ? `<div style="font-size:11px;color:#b86e00;margin-top:12px;">⚠ ${placeholderFiles.length} missing image${placeholderFiles.length > 1 ? 's' : ''} replaced with placeholders</div>` : ''}
      </body>`;

    } else {
      // Text output — display in editor/preview, enable download
      let outputText = '';
      if (files[outFileName]) {
        outputText = await files[outFileName].text();
      } else if (result.stdout) {
        outputText = result.stdout;
      }

      // Post-process: inject MathJax 4 config with accessibility defaults
      // Strategy: (1) remove Pandoc's CDN <script defer> tag,
      //           (2) insert config + CDN script before </head>.
      const mathMethod = document.getElementById('opt-math')?.value;
      if (mathMethod === 'mathjax4' && outputText.includes('tex-mml-chtml.js')) {

        // Step 1: Remove Pandoc's CDN script tag
        // (RegExp constructor avoids literal <\/script> in source — HTML parser safe)
        const deferRE = new RegExp(
          '<script\\s+defer[\\s\\S]*?tex-mml-chtml\\.js[\\s\\S]*?<' + '/script>'
        );
        outputText = outputText.replace(deferRE, '');

        // Step 2: Build config + CDN script block
        const ES = '<' + '/script>';   // end-script token (HTML-parser-safe)
        const mathScripts =
            '<script>\n'
          + 'MathJax = {\n'
          + '  loader: { load: ["a11y/assistive-mml", "[tex]/physics"] },\n'
          + '  tex: { packages: { "[+]": ["physics"] } },\n'
          + '  options: { menuOptions: { settings: { assistiveMml: true } } }\n'
          + '};\n'
          + ES + '\n'
          + '<script defer src="https://cdn.jsdelivr.net/npm/mathjax@4/tex-mml-chtml.js">'
          + ES + '\n';

        // Step 3: Insert before </head>
        outputText = outputText.replace('</head>', () => mathScripts + '</head>');
      }

      sourceEditor.setText(outputText);

      const previewFrame = document.getElementById('previewFrame');
      previewFrame.srcdoc = outputText;

      const blob = new Blob([outputText], { type: 'text/plain' });
      const sizeKB = (blob.size / 1024).toFixed(1);
      lastOutput = { blob, filename: outFileName };
      downloadBtn.textContent = `📥 ${outFileName} (${sizeKB} KB)`;
      downloadBtn.style.display = '';

      // Show SCORM download option only for HTML output with MathJax 4
      const isHtmlOutput = /\.html?$/i.test(outFileName);
      scormBtn.style.display = (isHtmlOutput && mathMethod === 'mathjax4') ? '' : 'none';
    }

    // Auto-populate cleanup patterns from warnings (user-toggleable)
    if (document.getElementById('chkAutoPopulate').checked) {
      populateCleanupFromWarnings(warnings);
    }

    // Status
    const warnCount = warnings.filter(w => w.level === 'warn').length;
    const errCount = warnings.filter(w => w.level === 'error').length;
    const infoCount = warnings.filter(w => w.level === 'info').length;
    let statusParts = [];
    if (errCount) statusParts.push(`${errCount} error${errCount > 1 ? 's' : ''}`);
    if (warnCount) statusParts.push(`${warnCount} warning${warnCount > 1 ? 's' : ''}`);
    if (infoCount) statusParts.push(`${infoCount} info`);

    const warningsEl = document.getElementById('statusWarnings');
    if (statusParts.length > 0) {
      warningsEl.style.display = '';
      warningsEl.style.color = errCount ? 'var(--error)' : warnCount ? 'var(--warning)' : 'var(--accent)';
      warningsEl.textContent = statusParts.join(', ');
    } else {
      warningsEl.style.display = 'none';
    }

    const statusMsg = placeholderFiles.length > 0
      ? `Converted ${options.from} → ${options.to} (${placeholderFiles.length} placeholder${placeholderFiles.length > 1 ? 's' : ''}) (${pandocVersion})`
      : `Converted ${options.from} → ${options.to} (${pandocVersion})`;
    updateStatus('ready', statusMsg);

  } catch (err) {
    console.error('Conversion error:', err);
    const missingFile = extractMissingFile(err.message);
    let userMessage = err.message;
    if (missingFile) {
      userMessage += `\n\nTip: Upload "${missingFile}" via the Media tab's "Upload Files" button, or remove the reference from your source.`;
    }
    updateStatus('error', `Error: ${err.message}`);
    updateLog([{ line: null, column: null, level: 'error', message: userMessage, matchedText: null, type: 'exception' }], '');
  } finally {
    btn.disabled = false;
    btn.textContent = 'Convert';
  }
}


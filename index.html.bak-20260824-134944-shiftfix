// ── SCORM package download ──────────────────────────────────────────
// Creates a minimal SCORM 2004 asset package (zip) containing:
//   - imsmanifest.xml  (SCORM manifest)
//   - index.html       (the converted HTML output)
// This bypasses Canvas LMS script restrictions, allowing MathJax to run.

/**
 * Build an uncompressed ZIP file from an array of {name, data} entries.
 * data must be Uint8Array. Returns a Uint8Array of the complete zip.
 */
function buildZip(entries) {
  const enc = new TextEncoder();
  const localHeaders = [];
  const centralHeaders = [];
  let offset = 0;

  for (const entry of entries) {
    const nameBytes = enc.encode(entry.name);
    const data = entry.data;

    // CRC-32 (standard table-driven)
    let crc = 0xFFFFFFFF;
    for (let i = 0; i < data.length; i++) {
      crc ^= data[i];
      for (let j = 0; j < 8; j++) crc = (crc >>> 1) ^ (crc & 1 ? 0xEDB88320 : 0);
    }
    crc ^= 0xFFFFFFFF;

    // Local file header (30 bytes + name + data)
    const local = new Uint8Array(30 + nameBytes.length + data.length);
    const lv = new DataView(local.buffer);
    lv.setUint32(0, 0x04034b50, true);  // signature
    lv.setUint16(4, 20, true);          // version needed
    lv.setUint16(8, 0, true);           // compression: STORE
    lv.setUint32(14, crc, true);        // crc-32
    lv.setUint32(18, data.length, true); // compressed size
    lv.setUint32(22, data.length, true); // uncompressed size
    lv.setUint16(26, nameBytes.length, true);
    local.set(nameBytes, 30);
    local.set(data, 30 + nameBytes.length);
    localHeaders.push(local);

    // Central directory header (46 bytes + name)
    const central = new Uint8Array(46 + nameBytes.length);
    const cv = new DataView(central.buffer);
    cv.setUint32(0, 0x02014b50, true);   // signature
    cv.setUint16(4, 20, true);           // version made by
    cv.setUint16(6, 20, true);           // version needed
    cv.setUint16(12, 0, true);           // compression: STORE
    cv.setUint32(16, crc, true);
    cv.setUint32(20, data.length, true);
    cv.setUint32(24, data.length, true);
    cv.setUint16(28, nameBytes.length, true);
    cv.setUint32(42, offset, true);      // local header offset
    central.set(nameBytes, 46);
    centralHeaders.push(central);

    offset += local.length;
  }

  // End of central directory
  const cdOffset = offset;
  let cdSize = 0;
  for (const c of centralHeaders) cdSize += c.length;

  const eocd = new Uint8Array(22);
  const ev = new DataView(eocd.buffer);
  ev.setUint32(0, 0x06054b50, true);
  ev.setUint16(8, entries.length, true);
  ev.setUint16(10, entries.length, true);
  ev.setUint32(12, cdSize, true);
  ev.setUint32(16, cdOffset, true);

  // Concatenate all parts
  const total = offset + cdSize + 22;
  const zip = new Uint8Array(total);
  let pos = 0;
  for (const l of localHeaders) { zip.set(l, pos); pos += l.length; }
  for (const c of centralHeaders) { zip.set(c, pos); pos += c.length; }
  zip.set(eocd, pos);
  return zip;
}

/**
 * Generate a SCORM 2004 imsmanifest.xml for a single HTML asset.
 */
function generateScormManifest(title) {
  return `<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns="http://www.imsglobal.org/xsd/imscp_v1p1"
          xmlns:adlcp="http://www.adlnet.org/xsd/adlcp_v1p3"
          identifier="harvard-atc-pandoc-scorm"
          version="1.0">
  <metadata>
    <schema>ADL SCORM</schema>
    <schemaversion>2004 3rd Edition</schemaversion>
  </metadata>
  <organizations>
    <organization identifier="org1">
      <title>${title.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')}</title>
      <item identifier="item1" identifierref="resource1">
        <title>${title.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')}</title>
      </item>
    </organization>
  </organizations>
  <resources>
    <resource identifier="resource1" type="webcontent" adlcp:scormType="asset" href="index.html">
      <file href="index.html"/>
    </resource>
  </resources>
</manifest>`;
}

// SCORM download button handler
document.getElementById('btnDownloadScorm').addEventListener('click', () => {
  if (!lastOutput) return;

  const enc = new TextEncoder();

  // Get the HTML content
  const htmlBlob = lastOutput.blob;
  const reader = new FileReader();
  reader.onload = () => {
    const htmlBytes = new Uint8Array(reader.result);

    // Extract title from the HTML for the manifest
    const htmlText = new TextDecoder().decode(htmlBytes);
    const titleMatch = htmlText.match(/<title>([\s\S]*?)<\/title>/i);
    const title = titleMatch ? titleMatch[1].trim() : lastOutput.filename.replace(/\.\w+$/, '');

    // Build the manifest
    const manifestXml = generateScormManifest(title);
    const manifestBytes = enc.encode(manifestXml);

    // Create the zip
    const zipData = buildZip([
      { name: 'imsmanifest.xml', data: manifestBytes },
      { name: 'index.html', data: htmlBytes }
    ]);

    // Trigger download
    const blob = new Blob([zipData], { type: 'application/zip' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    const baseName = lastOutput.filename.replace(/\.\w+$/, '');
    a.download = `${baseName}-scorm.zip`;
    a.click();
    URL.revokeObjectURL(url);
    maybeExportProfileWithOutput();
  };
  reader.readAsArrayBuffer(htmlBlob);
});


// ─── Sidebar toggle ───
const sidebar = document.getElementById('sidebar');
const btnCleanup = document.getElementById('btnCleanup');
const sidebarClose = document.getElementById('sidebarClose');

function toggleSidebar() {
  sidebar.classList.toggle('collapsed');
  btnCleanup.classList.toggle('active');
  const isExpanded = !sidebar.classList.contains('collapsed');
  btnCleanup.setAttribute('aria-expanded', String(isExpanded));
  // (CM6 self-measures after the CSS transition — no resize call needed)
}

btnCleanup.addEventListener('click', toggleSidebar);
sidebarClose.addEventListener('click', toggleSidebar);

// ─── Layout switching ───
const outputPanel = document.getElementById('outputPanel');
const resizeGutter = document.getElementById('resizeGutter');
const centerWrap = document.getElementById('centerWrap');
const editorArea = document.getElementById('editorArea');
const btnSide   = document.getElementById('btnLayoutSide');
const btnBottom = document.getElementById('btnLayoutBottom');
const btnHide   = document.getElementById('btnLayoutHide');

function setLayout(mode) {
  [btnSide, btnBottom, btnHide].forEach(b => {
    b.classList.remove('active');
    b.setAttribute('aria-pressed', 'false');
  });

  // Reset inline styles from any prior resize dragging
  editorArea.style.flex   = '';
  editorArea.style.width  = '';
  editorArea.style.height = '';
  outputPanel.style.flex   = '';
  outputPanel.style.width  = '';
  outputPanel.style.height = '';

  if (mode === 'side') {
    btnSide.classList.add('active');
    btnSide.setAttribute('aria-pressed', 'true');
    centerWrap.className = 'center-wrap';
    outputPanel.className = 'output-panel';
    resizeGutter.className = 'resize-gutter';
    resizeGutter.style.display = '';
  } else if (mode === 'bottom') {
    btnBottom.classList.add('active');
    btnBottom.setAttribute('aria-pressed', 'true');
    centerWrap.className = 'center-wrap vertical';
    outputPanel.className = 'output-panel bottom-mode';
    resizeGutter.className = 'resize-gutter horizontal';
    resizeGutter.style.display = '';
  } else {
    btnHide.classList.add('active');

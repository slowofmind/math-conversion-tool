  .log-level.info { color: var(--accent); background: rgba(43, 66, 110, 0.08); }
  .log-level.warn { color: var(--warning); background: rgba(184, 110, 0, 0.08); }
  .log-level.error { color: var(--error); background: rgba(198, 40, 40, 0.08); }

  .log-location { flex-shrink: 0; color: var(--text-muted); min-width: 60px; }
  .log-msg { color: var(--text-secondary); word-break: break-word; }

  /* Log badge */
  .log-badge {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    font-size: 11px;
    font-weight: 600;
    padding: 1px 6px;
    border-radius: 8px;
    margin-left: 4px;
  }
  .log-badge.warn { background: rgba(184, 110, 0, 0.12); color: var(--warning); }
  .log-badge.error { background: rgba(198, 40, 40, 0.12); color: var(--error); }
  .log-badge.info { background: rgba(43, 66, 110, 0.1); color: var(--accent); }

  /* ─── STATUS BAR ─── */
  .statusbar {
    height: var(--statusbar-height);
    background: var(--harvard-blue);
    border-top: none;
    display: flex;
    align-items: center;
    padding: 0 12px;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.85);
    gap: 16px;
    flex-shrink: 0;
  }

  .statusbar-item { display: flex; align-items: center; gap: 4px; }

  .status-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--text-muted); }

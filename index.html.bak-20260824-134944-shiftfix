// ── EPUB for Thorium Reader preset ───────────────────────────────────
// Synthetic output format: not a Pandoc format. buildOptions() normalises
// it to 'epub'; the MathJax payload is spliced into the EPUB afterwards.
const THORIUM_HEAD_NAME = '_thorium-mathjax-head.html';
const thoriumAssets = { headHtml: null, payloadBytes: null };

// ===========================================================================
// Pandoc EPUB writer repair: valueless attributes -> attr=""
// ===========================================================================
// See docs/pandoc-epub-bugs.md. Pandoc's EPUB writer serialises an empty
// attribute value as a bare attribute name, which is legal HTML but invalid
// XHTML. Every EPUB content document is rewritten so that any valueless
// attribute gets an explicit empty value.
//
// Normalising ALL valueless attributes (not just ext-*) is deliberate: XHTML
// requires a value for every attribute, including ones that are boolean in
// HTML (hidden, checked, disabled...). There is no valueless attribute that is
// valid in an EPUB content document, so a blanket fix cannot over-reach.
//
// The tag pattern tolerates quoted values containing < or > (data-latex holds
// both) and never matches closing tags. Only *.xhtml / *.html entries are
// touched; the OPF, NCX, CSS and payload pass through byte-for-byte.
const EPUB_TAG_WITH_ATTRS =
  /<([A-Za-z][\w:.-]*)((?:\s+[\w:.-]+(?:\s*=\s*(?:"[^"]*"|'[^']*'))?)*)\s*(\/?)>/g;
const EPUB_ONE_ATTR = /\s+([\w:.-]+)(\s*=\s*(?:"[^"]*"|'[^']*'))?/g;

function fixValuelessAttributes(text) {
  let count = 0;
  const out = text.replace(EPUB_TAG_WITH_ATTRS, (tag, name, attrs, slash) => {
    if (!attrs) return tag;
    let rebuilt = '';
    let changed = false;
    let m;
    EPUB_ONE_ATTR.lastIndex = 0;
    while ((m = EPUB_ONE_ATTR.exec(attrs)) !== null) {
      if (m[2] === undefined) {
        rebuilt += ' ' + m[1] + '=""';
        changed = true;
        count++;
      } else {
        rebuilt += ' ' + m[1] + m[2].replace(/^\s*=\s*/, '=');
      }
    }
    return changed ? '<' + name + rebuilt + (slash ? '/' : '') + '>' : tag;
  });
  return { text: out, count: count };
}

async function repairEpubEmptyAttributes(epubBytes) {
  const JSZipCtor = window.JSZip;
  if (!JSZipCtor) throw new Error('JSZip unavailable');
  const zin = await JSZipCtor.loadAsync(epubBytes);

  let changed = 0, docs = 0;
  const names = Object.keys(zin.files).filter((n) => !zin.files[n].dir);
  const edits = {};
  for (const n of names) {
    if (!/\.(xhtml|html)$/i.test(n)) continue;
    const t = await zin.file(n).async('string');
    const r = fixValuelessAttributes(t);
    if (r.count) { edits[n] = r.text; changed += r.count; docs++; }
  }
  if (!changed) return { data: epubBytes, changed: 0, docs: 0 };

  // Rebuild: mimetype MUST be first and STORED, per the EPUB OCF spec.
  const zout = new JSZipCtor();
  if (zin.file('mimetype')) {
    zout.file('mimetype', await zin.file('mimetype').async('uint8array'),
              { compression: 'STORE' });
  }
  for (const n of names) {
    if (n === 'mimetype') continue;
    if (edits[n] !== undefined) {
      zout.file(n, edits[n], { compression: 'DEFLATE' });
    } else {
      zout.file(n, await zin.file(n).async('uint8array'),
                { compression: 'DEFLATE' });
    }
  }
  const data = await zout.generateAsync({ type: 'uint8array',
                                          mimeType: 'application/epub+zip' });
  return { data: data, changed: changed, docs: docs };
}


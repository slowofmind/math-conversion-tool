// ════════════════════════════════════════════════════════════════════
// SECTION 13: LuaLaTeX COMPILATION (via GitHub Actions)
// ════════════════════════════════════════════════════════════════════
//
// Architecture:
//   1. User clicks LuaLaTeX → Compile
//   2. JS commits .tex to lualatex-pipeline-input/ via GitHub API
//   3. Push triggers lualatex-compile.yml workflow
//   4. Workflow runs LuaLaTeX in Docker, commits PDF to lualatex-pipeline-output/
//      (also creates a GitHub Release as backup)
//   5. JS polls for workflow completion, then fetches the PDF
//   6. PDF fetched via Contents API with raw media type (no base64)
//   7. PDF displayed in the preview iframe using browser's built-in PDF viewer

// --- Fetch a binary file from the repo as raw bytes (no base64) ---

async function fetchRepoFileRaw(path) {
  const token = getGitHubToken();
  if (!token) throw new Error('No GitHub token configured');

  const url = `${GITHUB_API_BASE}/contents/${path}`;
  const resp = await fetch(url, {
    headers: {
      'Authorization': `token ${token}`,
      'Accept': 'application/vnd.github.raw',
      'X-GitHub-Api-Version': '2022-11-28',
    },
  });

  if (!resp.ok) {
    throw new Error(`Failed to fetch ${path}: ${resp.status} ${resp.statusText}`);
  }

  return await resp.arrayBuffer();
}

// --- Display a PDF in the preview iframe ---

function displayPdfInPreview(pdfArrayBuffer, filename) {
  const blob = new Blob([pdfArrayBuffer], { type: 'application/pdf' });
  const blobUrl = URL.createObjectURL(blob);

  const previewFrame = document.getElementById('previewFrame');

  // Remove sandbox to allow browser's built-in PDF viewer to work.
  // This is safe because PDF blob URLs cannot execute scripts or access the parent page.
  previewFrame.removeAttribute('sandbox');

  // Clear any srcdoc and set src to the blob URL
  previewFrame.removeAttribute('srcdoc');
  previewFrame.src = blobUrl;

  // Store the blob URL for cleanup when switching away
  previewFrame._pdfBlobUrl = blobUrl;
}

// --- Restore iframe to HTML mode (re-enable sandbox) ---

function restoreHtmlPreview() {
  const previewFrame = document.getElementById('previewFrame');
  // Clean up any PDF blob URL
  if (previewFrame._pdfBlobUrl) {
    URL.revokeObjectURL(previewFrame._pdfBlobUrl);
    previewFrame._pdfBlobUrl = null;
  }
  // Restore sandbox for safe HTML rendering
  previewFrame.setAttribute('sandbox', 'allow-scripts');
  previewFrame.removeAttribute('src');
}

// --- Main LuaLaTeX compilation flow ---

async function runLualatexCompilation() {
  // Restore iframe sandbox in case previous output was a PDF
  restoreHtmlPreview();

  // Ensure we have a token (service token or user-provided)
  let token = getGitHubToken();
  if (!token) {
    token = promptForGitHubToken();
    if (!token) {
      updateStatus('error', 'GitHub token required for LuaLaTeX compilation');
      return;
    }
  }

  const btn = document.getElementById('btnConvert');
  const sourceText = inputBinaryFile ? null : getSourceForConversion();

  if (!sourceText || !sourceText.trim()) {
    updateStatus('error', 'No LaTeX source to compile');
    return;
  }

  // Check that input looks like LaTeX
  if (!sourceText.includes('\\documentclass') && !sourceText.includes('\\begin{document}')) {
    const proceed = confirm(
      'The source does not appear to contain \\documentclass.\n' +
      'LuaLaTeX requires a complete LaTeX document. Continue anyway?'
    );
    if (!proceed) return;
  }

  btn.disabled = true;
  btn.textContent = 'Compiling…';
  clearDecorations();

  // Use a timestamp to create a unique filename and avoid collisions
  const timestamp = Date.now();
  const baseName = inputFileName || 'untitled';
  const texFilename = `${baseName}-${timestamp}.tex`;
  const expectedPdf = `${baseName}-${timestamp}.pdf`;

  try {
    // Step 1: Commit the .tex file to lualatex-pipeline-input/
    updateStatus('loading', 'LuaLaTeX: uploading source…');
    const commitSha = await commitFileToRepo(
      `lualatex-pipeline-input/${texFilename}`,
      sourceText,
      `LuaLaTeX: ${baseName}.tex`
    );
    console.log('[lualatex] Committed lualatex-pipeline-input/' + texFilename, 'SHA:', commitSha);

    // Step 2: Wait for the GitHub Actions workflow to complete
    updateStatus('loading', 'LuaLaTeX: workflow queued…');
    const run = await waitForWorkflowRun(commitSha, 480000);  // 8 min timeout for compilation

    if (run.conclusion !== 'success') {
      const runUrl = run.html_url;
      throw new Error(
        `Workflow ${run.conclusion}. ` +
        `Check the Actions tab for details: ${runUrl}`
      );
    }
    console.log('[lualatex] Workflow completed:', run.html_url);

    // Step 3: Fetch the PDF from lualatex-pipeline-output/ via raw Contents API
    updateStatus('loading', 'LuaLaTeX: fetching PDF…');

    let pdfData = null;
    // Poll briefly — the workflow's commit may take a moment to propagate
    for (let attempt = 0; attempt < 8; attempt++) {
      try {
        pdfData = await fetchRepoFileRaw(`lualatex-pipeline-output/${expectedPdf}`);
        break;
      } catch (_) {
        if (attempt < 7) {
          await new Promise(r => setTimeout(r, 3000));
        }
      }
    }

    // If exact filename didn't work, scan the directory
    if (!pdfData) {
      const files = await listRepoDir('lualatex-pipeline-output');
      const match = files.find(f =>
        f.includes(baseName) && f.endsWith('.pdf')
      );
      if (match) {
        pdfData = await fetchRepoFileRaw(`lualatex-pipeline-output/${match}`);
      }
    }

    if (!pdfData) {
      throw new Error(
        'Compilation completed but PDF not found. ' +
        'Check the repo\'s lualatex-pipeline-output/ folder and the Actions tab.'
      );
    }

    const sizeKB = (pdfData.byteLength / 1024).toFixed(1);
    console.log(`[lualatex] Downloaded ${expectedPdf}: ${sizeKB} KB`);

    // Step 4: Display PDF in preview panel
    displayPdfInPreview(pdfData, expectedPdf);

    // Update source editor with compilation info
    sourceEditor.setText(
      `% LuaLaTeX compilation complete\n` +
      `% Output: ${expectedPdf} (${sizeKB} KB)\n` +
      `% The PDF is displayed in the Preview tab.`
    );

    // Store for download
    const blob = new Blob([pdfData], { type: 'application/pdf' });
    const downloadName = `${baseName}.pdf`;
    lastOutput = { blob, filename: downloadName };

    const downloadBtn = document.getElementById('btnDownloadOutput');
    downloadBtn.textContent = `📥 ${downloadName} (${sizeKB} KB)`;
    downloadBtn.style.display = '';

    // Hide SCORM button (not applicable for PDF)
    document.getElementById('btnDownloadScorm').style.display = 'none';

    // Update log
    updateLog([{
      line: null, column: null, level: 'info',
      message: `LuaLaTeX compilation complete (${sizeKB} KB). Output: ${downloadName}`,
      matchedText: null, type: 'lualatex-success',
    }], '');

    updateStatus('ready', `LuaLaTeX: compiled (${sizeKB} KB)`);

  } catch (err) {
    console.error('[lualatex] Error:', err);
    updateStatus('error', `LuaLaTeX: ${err.message.substring(0, 80)}`);
    updateLog([{
      line: null, column: null, level: 'error',
      message: `LuaLaTeX compilation failed: ${err.message}`,
      matchedText: null, type: 'lualatex-error',
    }], '');
  } finally {
    btn.disabled = false;
    btn.textContent = 'Compile';
  }
}



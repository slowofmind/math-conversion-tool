<script type="module">
// ════════════════════════════════════════════════════════════════════
// SECTION 1: EDITOR SETUP (CodeMirror 6 via facade — see CM6-FACADE-DESIGN.md)
// The `editor` and `sourceEditor` names are facade EditorHandles, not Ace
// instances. API: getText/setText, getCursor/gotoLine/focus, setLanguage,
// setReadOnly, setDiagnostics/clearDiagnostics, highlightRanges,
// registerCompletionSource, setLineWrap, setCompletionEnabled.
// Lines/columns are 1-based (matches Pandoc warning JSON).
// ════════════════════════════════════════════════════════════════════
import { createEditor } from './codemirror/cm6-editor.js';

const editor = createEditor(document.getElementById('aceEditor'), {
  language: 'latex',
  ariaLabel: 'Source editor',
  initialText: '',
  fontSize: '14px',
  fontFamily: "'Roboto Mono', monospace",
  lineWrap: true,
  scrollPastEnd: true,
  onCursor: (line, col) => {
    document.getElementById('statusCursor').textContent =
      `Ln ${line}, Col ${col}`;
  },
});

// Output source viewer (read-only)
const sourceEditor = createEditor(document.getElementById('outputSource'), {
  language: 'html',
  readOnly: true,
  ariaLabel: 'Output source viewer',
  fontSize: '13px',
  fontFamily: "'Roboto Mono', monospace",
  lineWrap: true,
});


// ════════════════════════════════════════════════════════════════════
// SECTION 2: PANDOC WASM INITIALIZATION
// ════════════════════════════════════════════════════════════════════

let pandocModule = null;
let pandocVersion = '';

async function initPandoc() {
  try {
    updateStatus('loading', 'Loading Pandoc WASM…');
    const mod = await import('./pandoc-wasm/pandoc.js');   // pandoc.js carries the synthetic "xform" device (DEVICE block)
    pandocModule = mod;

    // Query version
    pandocVersion = await mod.query({ query: 'version' });
    updateStatus('ready', `Pandoc WASM ${pandocVersion} ready`);
    document.getElementById('btnConvert').disabled = false;

    // Populate format dropdowns
    const inputFormats = await mod.query({ query: 'input-formats' });
    const outputFormats = await mod.query({ query: 'output-formats' });
    populateFormats('selFrom', filterFormats(inputFormats, INPUT_FORMAT_ALLOW), 'latex');
    populateFormats('selTo', filterFormats(outputFormats, OUTPUT_FORMAT_ALLOW), 'html5');
    refreshMathOptions();    // math methods for the default output format

    // Load extensions for default formats
    updateExtensions();

  } catch (err) {
    console.error('Failed to load pandoc.wasm:', err);
    updateStatus('error', `Failed to load: ${err.message}`);
  }
}

// ── Visible format allowlists ─────────────────────────────
// Internal capability is unchanged; this only limits what the dropdowns show.
// A future 'production mode' can bypass these and expose the full Pandoc set.
// Order here IS the display order. Verified on Pandoc 3.10: 'html5' and 'html'
// are the same writer (byte-identical output), and 'epub' and 'epub3' are the
// same (package version 3.0). We keep 'html5'/'epub' as the internal values so
// pandocDefaultTo and the LaTeXML engine path need no changes.
const INPUT_FORMAT_ALLOW  = ['latex', 'markdown'];
const OUTPUT_FORMAT_ALLOW = ['html5', 'docx', 'chunkedhtml', 'epub'];

const FORMAT_LABELS = {
  'latex': 'LaTeX', 'markdown': 'Markdown',
  'html5': 'HTML', 'docx': 'DOCX', 'chunkedhtml': 'Chunked HTML', 'epub': 'EPUB'
};

// Keep allowlist order; drop anything this Pandoc build doesn't offer.
function filterFormats(available, allow) {
  const have = new Set(available);
  return allow.filter(f => have.has(f));
}

// ── Output-format families for math handling ───────────────────
// 'chunkedhtml' does NOT start with 'html', so a bare /^html/ test excludes it.
function isHtmlFamily(fmt) {
  const b = (fmt || '').split(/[+-]/)[0];
  return /^html/.test(b) || b === 'chunkedhtml';
}
function isEpubFamily(fmt) {
  return /^epub/.test((fmt || '').split(/[+-]/)[0]);
}
function mathFamilyFor(fmt) {
  const b = (fmt || '').split(/[+-]/)[0];
  if (isHtmlFamily(b)) return 'html';
  if (isEpubFamily(b)) return 'epub';
  if (b === 'docx') return 'docx';
  return null;
}

// ── Math methods offered per output family ───────────────────
// [internal value, visible label]. FIRST ENTRY IS THE DEFAULT for that family.
// Convention: custom pipelines first, stock Pandoc behaviour last.
// NOTE: 'epub-thorium' was formerly a synthetic OUTPUT format; it is now a
// MATH METHOD. The string is reused so isThoriumPreset() and its downstream
// call sites keep working unchanged. Rename in the production-mode pass.
const MATH_METHODS = {
  html: [
    ['mathjax-mathml-intent', 'MathML (custom MathJax conversion + SRE speech)'],
    ['mathjax-mathml',        'MathML (custom MathJax conversion)'],
    ['mathjax4',              'MathJax (default script reference)'],
    ['mathml',                'MathML (default texmath)']
  ],
  docx: [
    ['mathjax-omml', 'OMML (custom MathJax conversion)'],
    ['',             'OMML (default texmath)']
  ],
  epub: [
    ['mathjax-mathml', 'MathML (custom MathJax conversion)'],
    ['epub-thorium',   'full MathJax library for Thorium reader'],
    ['mathml',         'MathML (default texmath)']
  ]
};

// Rebuild the math dropdown for the current output format. Preserves the
// current selection when still valid, else falls back to the family default
// (first entry). Unknown formats (e.g. LuaLaTeX 'pdf' mode) are left alone
// rather than blanked.
function refreshMathOptions() {
  const sel = document.getElementById('opt-math');
  if (!sel) return;
  const fam = mathFamilyFor(document.getElementById('selTo')?.value);
  if (!fam || !MATH_METHODS[fam]) return;
  const list = MATH_METHODS[fam];
  const prev = sel.value;
  sel.innerHTML = '';
  for (const [value, label] of list) {
    const opt = document.createElement('option');
    opt.value = value;
    opt.textContent = label;
    sel.appendChild(opt);
  }
  sel.value = list.some(([v]) => v === prev) ? prev : list[0][0];
}

function populateFormats(selectId, formats, defaultVal) {
  const sel = document.getElementById(selectId);
  sel.innerHTML = '';
  for (const fmt of formats) {
    const opt = document.createElement('option');
    opt.value = fmt;
    opt.textContent = FORMAT_LABELS[fmt] || fmt;
    if (fmt === defaultVal) opt.selected = true;
    sel.appendChild(opt);
  }
}

function updateStatus(state, text) {
  const dot = document.getElementById('statusDot');
  const txt = document.getElementById('statusText');
  dot.className = 'status-dot ' + state;
  txt.textContent = text;
}

// ════════════════════════════════════════════════════════════════════
// SECTION 3: FILE UPLOAD
// ════════════════════════════════════════════════════════════════════

const fileInput = document.getElementById('fileInput');

// Shared file upload handler (used by button upload and drag-and-drop)
async function handleFileUpload(file) {
  if (!file) return;

  // Auto-detect format from extension
  const ext = file.name.split('.').pop().toLowerCase();
  // Project zips route to the multi-file importer (main doc -> editor,
  // other entries -> auxiliary files). Covers picker and drag-and-drop.
  if (ext === 'zip') {
    await importProjectZip(await file.arrayBuffer(), `"${file.name}"`);
    return;
  }
  const formatMap = {
    'tex': 'latex', 'latex': 'latex', 'md': 'markdown', 'markdown': 'markdown',
    'html': 'html', 'htm': 'html', 'rst': 'rst', 'org': 'org', 'typ': 'typst',
    'txt': 'markdown', 'docx': 'docx', 'odt': 'odt', 'pptx': 'pptx',
    'epub': 'epub', 'fb2': 'fb2', 'ipynb': 'ipynb',
  };
  const fmt = formatMap[ext];

  if (fmt && BINARY_INPUT_FORMATS.includes(fmt)) {
    // Binary input — store as blob, show overlay
    inputBinaryFile = { name: file.name, blob: file };
    editor.setText('');
    editor.setReadOnly(true);

    // Update tab name and track filename
    document.getElementById('tabFilename').textContent = file.name;
    inputFileName = file.name.replace(/\.[^.]+$/, '') || 'untitled';

    if (fmt) {
      document.getElementById('selFrom').value = fmt;
      document.getElementById('statusFormat').textContent = fmt;
      updateExtensions();
    }

    // Show binary input overlay
    const iconMap = { 'docx': '📝', 'odt': '📝', 'pptx': '📊', 'epub': '📚', 'fb2': '📚', 'ipynb': '📓' };
    document.getElementById('binaryInputIcon').textContent = iconMap[fmt] || '📄';
    document.getElementById('binaryInputName').textContent = file.name;
    document.getElementById('binaryInputMeta').textContent =
      `${fmt.toUpperCase()} · ${(file.size / 1024).toFixed(1)} KB`;
    document.getElementById('binaryInputOverlay').style.display = 'flex';

  } else {
    // Text input — clear binary state first, then set names
    clearBinaryInput();

    // Update tab name and track filename (after clear so they aren't overwritten)
    document.getElementById('tabFilename').textContent = file.name;
    inputFileName = file.name.replace(/\.[^.]+$/, '') || 'untitled';

    const text = await file.text();
    editor.setText(text);

    if (fmt) {
      document.getElementById('selFrom').value = fmt;
      const modeMap = { 'latex': 'latex', 'markdown': 'markdown', 'html': 'html' };

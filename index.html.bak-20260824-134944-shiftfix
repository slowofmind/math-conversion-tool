<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Accessible STEM: A Toolkit for Instructor-Created Course Content</title>

<!-- Editor: CodeMirror 6 facade bundle (built from cm6-src/, see CM6-FACADE-DESIGN.md).
     Imported as an ES module inside the main script; no script tags needed here.
     The ace/ folder is retired by the cm6-migration branch. -->

<style>
  @import url('https://fonts.googleapis.com/css2?family=Merriweather:wght@400;700&family=Roboto+Mono:wght@400;500;600&family=Roboto:wght@400;500;700&display=swap');

  :root {
    /* Harvard identity */
    --harvard-blue: #2b426e;
    --harvard-blue-dark: #1e2f4d;
    --harvard-crimson: #a51c30;
    --harvard-crimson-dark: #8c1826;

    /* Light theme surfaces */
    --bg-primary: #ffffff;
    --bg-secondary: #f5f5f5;
    --bg-tertiary: #eaeaea;
    --bg-elevated: #e0e0e0;
    --bg-surface: #d9d9d9;
    --border: #cccccc;
    --border-subtle: #ddd;
    --text-primary: #1e2124;
    --text-secondary: #4a4a4a;
    --text-muted: #666666;
    --accent: #2b426e;
    --accent-dim: #1e2f4d;
    --accent-glow: rgba(43, 66, 110, 0.08);
    --success: #2e7d32;
    --warning: #b86e00;
    --error: #c62828;
    --titlebar-height: 32px;
    --toolbar-height: 40px;
    --statusbar-height: 26px;
    --sidebar-width: 300px;
    --gutter: 5px;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    font-family: 'Roboto', sans-serif;
    background: var(--bg-primary);
    color: var(--text-primary);
    height: 100vh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  /* ─── TITLE BAR ─── */
  .title-bar {
    height: var(--titlebar-height);
    background: var(--harvard-blue);
    display: flex;
    align-items: center;
    padding: 0 16px;
    flex-shrink: 0;
    z-index: 101;
  }

  .toolbar-title {
    font-family: 'Merriweather', serif;
    font-size: 14px;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: 0.04em;
  }

  /* ─── TOOLBAR (controls) ─── */
  .toolbar {
    height: var(--toolbar-height);
    background: #ffffff;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    padding: 0 12px;
    gap: 8px;
    flex-shrink: 0;
    z-index: 100;
  }

  .toolbar-group { display: flex; align-items: center; gap: 6px; }
  .toolbar-divider { width: 1px; height: 20px; background: var(--border); margin: 0 6px; }
  .toolbar-spacer { flex: 1; }

  .toolbar-btn {
    font-family: 'Roboto', sans-serif;
    font-size: 13px;
    font-weight: 500;
    padding: 5px 12px;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: #ffffff;
    color: var(--text-primary);
    cursor: pointer;
    transition: all 0.15s;
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 5px;
  }
  .toolbar-btn:hover { background: var(--bg-secondary); border-color: var(--text-muted); }
  .toolbar-btn.active { background: var(--accent-glow); border-color: var(--accent); color: var(--accent); }
  .toolbar-btn.primary { background: var(--harvard-blue); border-color: var(--harvard-blue); color: #fff; }
  .toolbar-btn.primary:hover { background: var(--harvard-blue-dark); }
  .toolbar-btn:disabled { opacity: 0.5; cursor: not-allowed; }

  .toolbar-select {
    font-family: 'Roboto', sans-serif;
    font-size: 13px;
    padding: 4px 8px;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: #ffffff;
    color: var(--text-primary);
    cursor: pointer;
    min-width: 100px;
  }

  .toolbar-label { font-size: 13px; color: var(--text-secondary); font-weight: 500; }

  /* ─── ENGINE SWITCHER ─── */
  .engine-group {
    display: flex;
    gap: 3px;
    padding: 3px;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 6px;
  }
  .engine-btn {
    font-family: 'Roboto', sans-serif;
    font-size: 13px;
    font-weight: 400;
    padding: 4px 14px;
    border: 1px solid transparent;
    border-radius: 4px;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    transition: all 0.15s;
    white-space: nowrap;
  }
  .engine-btn:hover { color: var(--text-secondary); background: rgba(0,0,0,0.03); }
  .engine-btn.active {
    background: var(--bg-primary);
    border-color: var(--border);
    color: var(--text-primary);
    font-weight: 500;
    box-shadow: 0 1px 2px rgba(0,0,0,0.06);
  }

  /* Pipeline info note below options tabs */
  .pipeline-note {
    font-size: 12px;
    color: var(--text-muted);
    padding: 4px 12px 6px;
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border);
    line-height: 1.5;
  }

  /* ─── MAIN LAYOUT ─── */
  .main-area {
    flex: 1;
    display: flex;
    overflow: hidden;
    position: relative;
  }

  /* ─── SIDEBAR (Cleanup Tool) ─── */
  .sidebar {
    width: var(--sidebar-width);
    min-width: var(--sidebar-width);
    max-width: var(--sidebar-width);
    background: var(--bg-secondary);
    border-right: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: width 0.2s ease, min-width 0.2s ease, max-width 0.2s ease, visibility 0.2s ease;
    flex-shrink: 0;
  }

  .sidebar.collapsed {
    width: 0;
    min-width: 0;
    max-width: 0;
    border-right: none;
    padding: 0;
    visibility: hidden;
  }

  .sidebar-header {
    padding: 10px 12px;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
  }

  .sidebar-title {
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-secondary);
  }

  .sidebar-close {
    background: none;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    font-size: 16px;
    padding: 2px;
    line-height: 1;
    border-radius: 3px;
  }
  .sidebar-close:hover { color: var(--text-primary); background: var(--bg-elevated); }

  .sidebar-body {
    flex: 1;
    overflow-y: auto;
    padding: 10px 12px;
  }

  .cleanup-section { margin-bottom: 14px; }

  .cleanup-section-label {
    font-size: 12px;
    font-weight: 700;
    color: var(--text-secondary);
    margin-bottom: 6px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .cleanup-select {
    width: 100%;
    padding: 5px 8px;
    font-size: 13px;
    font-family: 'Roboto', sans-serif;
    border: 1px solid var(--border);
    border-radius: 3px;
    background: var(--bg-tertiary);
    color: var(--text-primary);
  }

  /* ─── Pattern list ─── */
  .pattern-item {
    border: 1px solid var(--border-subtle);
    border-radius: 3px;
    margin-bottom: 4px;
    background: var(--bg-primary);
    overflow: hidden;
  }
  .pattern-item.from-warning { border-left: 3px solid var(--warning); }

  .pattern-item-header {
    display: flex;
    align-items: center;
    padding: 5px 8px;
    gap: 4px;
    cursor: pointer;
  }
  .pattern-item-header:hover { background: var(--bg-tertiary); }

  .pattern-toggle {
    width: 14px;
    font-size: 14px;
    color: var(--text-muted);
    flex-shrink: 0;
    text-align: center;
    user-select: none;
  }

  .pattern-summary {
    flex: 1;
    min-width: 0;
    font-size: 13px;
    font-family: 'Roboto Mono', monospace;
    color: var(--text-secondary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .pattern-delete {
    opacity: 0;
    background: none;
    border: none;
    color: var(--error);
    font-size: 14px;
    cursor: pointer;
    padding: 0 2px;
    flex-shrink: 0;
  }
  .pattern-item-header:hover .pattern-delete { opacity: 1; }
  .pattern-delete:hover { color: #fff; background: var(--error); border-radius: 2px; }

  /* ─── Pattern expanded fields ─── */
  .pattern-fields {
    padding: 8px 10px;
    border-top: 1px solid var(--border-subtle);
    background: var(--bg-secondary);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .pf-row {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .pf-label {
    font-size: 10px;
    font-weight: 600;
    color: var(--text-muted);
    width: 16px;
    flex-shrink: 0;
    text-align: right;
  }

  .pf-input {
    padding: 3px 5px;
    border: 1px solid var(--border);
    background: var(--bg-primary);
    color: var(--text-primary);
    font-size: 12px;
    font-family: 'Roboto Mono', monospace;
    border-radius: 2px;
  }
  .pf-input:focus { border-color: var(--accent); outline: 2px solid var(--accent); outline-offset: -1px; }
  .pf-input::placeholder { color: var(--text-muted); opacity: 0.5; font-family: 'Roboto', sans-serif; }

  .pf-input-anchor { width: 50px; flex-shrink: 0; }
  .pf-input-flex { flex: 1; min-width: 40px; }

  .pf-select {
    padding: 3px 5px;
    border: 1px solid var(--border);
    background: var(--bg-primary);
    color: var(--text-primary);
    font-size: 12px;
    font-family: 'Roboto', sans-serif;
    border-radius: 2px;
  }

  .pf-arrow { color: var(--text-muted); font-size: 11px; padding: 0 2px; flex-shrink: 0; }

  .pf-checkbox {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 12px;
    color: var(--text-muted);
    white-space: nowrap;
    margin-left: 6px;
    flex-shrink: 0;
  }

  .pf-note {
    font-size: 12px;
    color: var(--text-muted);
    font-style: italic;
    padding-left: 20px;
  }

  /* ─── Scope section ─── */
  .scope-section {
    border: 1px solid var(--border-subtle);
    border-radius: 3px;
    background: var(--bg-primary);
    margin-top: 6px;
  }

  .scope-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 5px 8px;
    cursor: pointer;
    font-size: 13px;
    color: var(--text-muted);
  }
  .scope-header:hover { background: var(--bg-tertiary); }

  .scope-fields {
    padding: 8px;
    border-top: 1px solid var(--border-subtle);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .cleanup-run-btn {
    width: 100%;
    padding: 7px;
    font-family: 'Roboto', sans-serif;
    font-size: 13px;
    font-weight: 600;
    background: var(--harvard-crimson);
    color: #fff;
    border: 1px solid var(--harvard-crimson);
    border-radius: 4px;
    cursor: pointer;
    margin-top: 10px;
    transition: background 0.15s;
  }
  .cleanup-run-btn:hover { background: var(--harvard-crimson-dark); }

  /* ─── EDITOR AREA ─── */
  .editor-area {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 200px;
    overflow: hidden;
  }

  .editor-tabs {
    display: flex;
    align-items: center;
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border);
    height: 32px;
    flex-shrink: 0;
    padding: 0 4px;
    gap: 2px;
  }

  .editor-tab {
    font-family: 'Roboto', sans-serif;
    font-size: 13px;
    padding: 5px 14px;
    background: transparent;
    color: var(--text-muted);
    border: none;
    border-bottom: 2px solid transparent;
    cursor: pointer;
    transition: all 0.1s;
    white-space: nowrap;
  }
  .editor-tab:hover { color: var(--text-secondary); }
  .editor-tab.active { color: var(--text-primary); border-bottom-color: var(--accent); background: var(--bg-primary); }

  .editor-content { flex: 1; position: relative; overflow: hidden; border-left: 3px solid var(--harvard-crimson); transition: box-shadow 0.15s; }
  .editor-content.drag-over { box-shadow: inset 0 0 0 3px var(--harvard-blue); }

  /* Editor container (CM6 mounts here and fills it) */
  #aceEditor {
    position: absolute;
    inset: 0;
  }

  /* Binary input overlay */
  .binary-input-overlay {
    position: absolute; inset: 0; z-index: 10;
    background: rgba(255, 255, 255, 0.95);
    display: flex; align-items: center; justify-content: center;
  }
  .binary-input-card {
    text-align: center; padding: 32px 40px;
    background: #ffffff; border: 1px solid var(--border);
    border-radius: 8px; max-width: 360px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.08);
  }
  .binary-input-icon { font-size: 48px; margin-bottom: 12px; }
  .binary-input-filename {
    font-family: 'Roboto Mono', monospace; font-size: 15px;
    font-weight: 600; color: var(--text-primary); margin-bottom: 4px;
    word-break: break-all;
  }
  .binary-input-meta {
    font-size: 12px; color: var(--text-secondary); margin-bottom: 16px;
  }
  .binary-input-hint {
    font-size: 12px; color: var(--text-muted); line-height: 1.5; margin-bottom: 18px;
  }
  .binary-input-clear {
    background: #ffffff; border: 1px solid var(--border); border-radius: 4px;
    color: var(--text-secondary); font-size: 13px; padding: 5px 14px;
    cursor: pointer; font-family: 'Roboto', sans-serif;
  }
  .binary-input-clear:hover { color: var(--error); border-color: var(--error); }

  /* PDF conversion prompt modal */
  .pdf-modal-overlay {
    position: fixed; inset: 0; z-index: 1000;
    background: rgba(0,0,0,0.45);
    display: flex; align-items: center; justify-content: center;
  }
  .pdf-modal {
    background: #ffffff; border: 1px solid var(--border);
    border-radius: 8px; padding: 24px 28px; max-width: 420px; width: 90%;
    max-height: 85vh; display: flex; flex-direction: column;
    box-shadow: 0 8px 32px rgba(0,0,0,0.15);
  }
  .pdf-modal h3 {
    margin: 0 0 8px; font-size: 15px; font-weight: 600; color: var(--text-primary);
  }
  .pdf-modal p {
    margin: 0 0 16px; font-size: 13px; color: var(--text-secondary); line-height: 1.5;
  }
  .pdf-modal ul {
    margin: 0 0 16px; padding-left: 20px; font-size: 13px;
    overflow-y: auto; flex: 1 1 auto; min-height: 0;
    color: var(--text-secondary); line-height: 1.6;
    font-family: 'Roboto Mono', monospace;
  }
  .pdf-modal-list {
    overflow-y: auto; flex: 1 1 auto; min-height: 0; margin: 0 0 16px;
  }
  .pdf-modal-actions {
    display: flex; gap: 8px; justify-content: flex-end;
  }
  .pdf-modal-btn {
    padding: 6px 16px; border-radius: 4px; font-size: 13px; cursor: pointer;
    font-family: 'Roboto', sans-serif; border: 1px solid var(--border);
    background: #ffffff; color: var(--text-primary);
  }
  .pdf-modal-btn:hover { background: var(--bg-secondary); }
  .pdf-modal-btn.primary {
    background: var(--harvard-blue); color: #fff; border-color: var(--harvard-blue);
  }
  .pdf-modal-btn.primary:hover { opacity: 0.9; }

  /* CodeMirror 6 gutter + severity styling (replaces Ace overrides) */
  .cm-editor .cm-gutters { background: var(--bg-secondary); border-right: 1px solid var(--border); color: var(--text-muted); }
  .cm-editor.cm-focused { outline: none; }
  .cm-lint-marker-info    { content: none; }
  .cm-gutter-lint .cm-lint-marker { width: 0.9em; }

  /* Pandoc warning/error/info decorations (CM6 line/mark classes — no
     absolute positioning; CM6 applies these to real content elements) */
  .pandoc-warning-line { background: rgba(255, 193, 7, 0.18); box-shadow: inset 3px 0 0 var(--warning); }
  .pandoc-error-line { background: rgba(198, 40, 40, 0.14); box-shadow: inset 3px 0 0 var(--error); }
  .pandoc-info-line { background: rgba(255, 193, 7, 0.13); box-shadow: inset 3px 0 0 #d4a017; }
  .pandoc-warning-text { background: rgba(255, 170, 0, 0.38); border-bottom: 2px solid var(--warning); }
  .pandoc-error-text { background: rgba(198, 40, 40, 0.30); border-bottom: 2px solid var(--error); }
  .pandoc-info-text { background: rgba(255, 170, 0, 0.32); border-bottom: 2px solid #d4a017; }

  /* ─── Intent findings (SECTION 8c) ───
     Deliberately LIGHT. A set-theory worksheet can carry 60+ findings, and
     solid highlight blocks at that density read as damage rather than as
     information. A dotted underline plus a faint wash marks every finding;
     only the one being reviewed gets a strong (crimson) treatment. */
  .intent-finding {
    background: rgba(43, 66, 110, 0.06);
    border-bottom: 2px dotted var(--harvard-blue);
  }
  .intent-finding-current {
    background: rgba(165, 28, 48, 0.16);
    border-bottom: 2px solid var(--harvard-crimson);
  }

  .intent-nav { display: flex; align-items: center; gap: 3px; margin-right: 2px; }
  .intent-nav[hidden] { display: none; }
  .intent-nav-status {
    font-size: 11px;
    color: var(--text-secondary);
    min-width: 92px;
    text-align: center;
    white-space: nowrap;
  }
  .intent-nav-status.stale { color: var(--warning); font-weight: 500; }

  /* Review panel (Intent output tab) */
  .intent-panel { padding: 12px 14px; overflow: auto; height: 100%;
    font-size: 13px; line-height: 1.5; }
  .intent-panel-empty { color: var(--text-muted); font-size: 12px; max-width: 46em; }
  .intent-progress { font-size: 11px; color: var(--text-muted);
    text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 8px; }
  .intent-finding-head { font-size: 14px; font-weight: 600; margin-bottom: 6px;
    display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; }
  .intent-head-pos { color: var(--text-secondary); font-weight: 500; }
  .intent-head-text { font-family: 'Roboto Mono', monospace; background: var(--bg-secondary);
    border: 1px solid var(--border); border-radius: 3px; padding: 1px 5px; }
  .intent-head-meta { font-size: 11px; color: var(--text-muted); font-weight: 400; }
  .intent-notes { margin-bottom: 8px; }
  .intent-note { font-size: 12px; color: var(--text-secondary);
    border-left: 3px solid var(--warning); padding-left: 8px; margin: 3px 0; }
  .intent-note-resolved { font-size: 12px; color: var(--success);
    border-left: 3px solid var(--success); padding-left: 8px; margin: 3px 0; }

  .intent-cand { display: block; border: 1px solid var(--border); border-radius: 5px;
    padding: 7px 9px; margin: 5px 0; cursor: pointer; background: #fff; }
  .intent-cand:hover { border-color: var(--accent); }
  .intent-cand:has(input:checked) { border-color: var(--accent);
    background: var(--accent-glow); }
  .intent-cand:has(input:focus-visible) { outline: 2px solid var(--accent);
    outline-offset: 1px; }
  .intent-cand:has(input:disabled) { opacity: 0.6; cursor: default; }
  .intent-cand input { margin-right: 7px; accent-color: var(--accent); }
  .intent-cand-main { display: inline; }
  .intent-cand-name { font-family: 'Roboto Mono', monospace; font-weight: 600; }
  .intent-cand-say { margin-left: 8px; color: var(--text-primary); }
  .intent-cand-write { font-size: 12px; color: var(--text-secondary); margin: 3px 0 0 24px; }
  .intent-cand-write code { font-family: 'Roboto Mono', monospace;
    background: var(--bg-secondary); padding: 1px 4px; border-radius: 3px; }
  .intent-cand-why { font-size: 11px; color: var(--text-muted); margin: 3px 0 0 24px; }
  .intent-cand-badge { font-size: 10px; border-radius: 9px; padding: 1px 7px;
    margin-left: 6px; vertical-align: middle; }
  .intent-cand-badge.b-none { background: rgba(46,125,50,0.10); color: var(--success);
    border: 1px solid rgba(46,125,50,0.35); }
  .intent-cand-badge.b-warn { background: rgba(184,110,0,0.10); color: var(--warning);
    border: 1px solid rgba(184,110,0,0.35); }

  .intent-panel-actions { display: flex; align-items: center; gap: 6px;
    margin-top: 12px; padding-top: 10px; border-top: 1px solid var(--border); }

  /* Visible to screen readers only. */
  .sr-only {
    position: absolute; width: 1px; height: 1px;
    padding: 0; margin: -1px; overflow: hidden;
    clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
  }

  /* ─── SYNTAX TOKEN PALETTE (CM6 classHighlighter) ───
     The facade stamps stable .tok-* classes on every syntax token; colors
     live HERE, not in the bundle, so palette changes never need a rebuild.
     defaultHighlightStyle (in the bundle) already colors keywords, comments,
     strings, headings, class/env names, etc. — the rules below cover only
     the tags it leaves unpainted, which is where the LaTeX grammar puts
     most math tokens ($ delimiters, math identifiers, operators, braces).
     The .cm-editor prefix outranks CM's runtime-injected default colors
     (e.g. Dollar otherwise inherits meta-gray from the default style). */
  .cm-editor .tok-processingInstruction { color: #b05a00; font-weight: 600; } /* math delimiters: $ \( \[ */
  .cm-editor .tok-variableName { color: #116d9e; }  /* math identifiers/content */
  .cm-editor .tok-operator { color: #9333aa; }      /* \symbols, & ~ and math operators */
  .cm-editor .tok-bracket { color: #8a6d1a; }       /* { } [ ] and math open/close */
  .cm-editor .tok-number { color: #1a7f37; }

  /* ─── RESIZE GUTTER ─── */
  .resize-gutter {
    width: 5px;
    background: var(--bg-secondary);
    cursor: col-resize;
    flex-shrink: 0;
    z-index: 10;
    transition: background 0.1s;
  }
  .resize-gutter:hover, .resize-gutter.dragging { background: var(--accent-dim); }
  .resize-gutter.horizontal { height: 5px; width: 100%; cursor: row-resize; }

  /* ─── OUTPUT PANEL ─── */
  .output-panel {

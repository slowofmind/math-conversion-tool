// Generate a visible placeholder PNG with warning text for a missing image
function generatePlaceholderImage(filename) {
  return new Promise((resolve) => {
    const canvas = document.createElement('canvas');
    canvas.width = 400;
    canvas.height = 120;
    const ctx = canvas.getContext('2d');

    // Background
    ctx.fillStyle = '#fff3cd';
    ctx.fillRect(0, 0, 400, 120);
    ctx.strokeStyle = '#ffc107';
    ctx.lineWidth = 2;
    ctx.strokeRect(1, 1, 398, 118);

    // Warning icon and text
    ctx.fillStyle = '#856404';
    ctx.font = 'bold 16px sans-serif';
    ctx.fillText('⚠ Missing Image', 16, 36);
    ctx.font = '13px sans-serif';
    ctx.fillText(filename, 16, 62);
    ctx.fillStyle = '#a07000';
    ctx.font = '11px sans-serif';
    ctx.fillText('Upload the actual image via the Media tab', 16, 88);
    ctx.fillText('to replace this placeholder.', 16, 104);

    canvas.toBlob((blob) => resolve(blob), 'image/png');
  });
}

// Extract missing filename from pandoc error messages
function extractMissingFile(errMsg) {
  // Match patterns like: "File domain.png not found in resource path"
  const m = errMsg.match(/File\s+(\S+)\s+not found in resource path/i);
  return m ? m[1] : null;
}

// --- Build pandoc options object from all tabs ---
function buildOptions() {
  const fromFmt = document.getElementById('selFrom').value;
  const toFmtRaw = document.getElementById('selTo').value;
  const thoriumPreset = isThoriumPreset();   // now driven by the math method
  const toFmt = toFmtRaw;
  const opts = {
    from: buildFormatWithExtensions(fromFmt, inputExtensions),
    to: buildFormatWithExtensions(toFmt, outputExtensions),
  };

  // General
  if (document.getElementById('opt-standalone').checked) opts.standalone = true;
  if (document.getElementById('opt-file-scope').checked) opts['file-scope'] = true;
  const tabStop = parseInt(document.getElementById('opt-tab-stop').value);
  if (tabStop !== 4) opts['tab-stop'] = tabStop;
  if (document.getElementById('opt-preserve-tabs').checked) opts['preserve-tabs'] = true;
  const eol = document.getElementById('opt-eol').value;
  if (eol) opts.eol = eol;

  // Headings (wired later)
  const shiftEl = document.getElementById('opt-shift-heading');
  if (shiftEl) {
    const shift = parseInt(shiftEl.value);
    if (shift !== 0) opts['shift-heading-level-by'] = shift;
  }
  const numSec = document.getElementById('opt-number-sections');
  if (numSec && numSec.checked) opts['number-sections'] = true;
  const numOff = document.getElementById('opt-number-offset');
  if (numOff && numOff.value.trim()) {
    opts['number-offset'] = numOff.value.trim().split(',').map(n => parseInt(n.trim()) || 0);
  }
  const tocEl = document.getElementById('opt-toc');
  if (tocEl && tocEl.checked) {
    opts['table-of-contents'] = true;
    const tocDepth = document.getElementById('opt-toc-depth');
    if (tocDepth) opts['toc-depth'] = parseInt(tocDepth.value);
  }

  // Media (wired later)
  const extractMedia = document.getElementById('opt-extract-media');
  if (extractMedia && extractMedia.checked) opts['extract-media'] = 'media.zip';
  const dpi = document.getElementById('opt-dpi');
  if (dpi && dpi.value) opts.dpi = parseInt(dpi.value);
  const resPath = document.getElementById('opt-resource-path');
  // Pandoc's defaults format takes resource-path as a LIST, not the CLI's
  // colon/semicolon-joined string — split before passing to convert().
  if (resPath && resPath.value.trim()) {
    opts['resource-path'] = resPath.value.trim().split(/[;:]/).filter(Boolean);
  }

  // Citations (wired later)
  const citMethod = document.getElementById('opt-citation-method');
  if (citMethod) {
    const method = citMethod.value;
    if (method === 'citeproc') opts.citeproc = true;
    else if (method === 'natbib') opts.natbib = true;
    else if (method === 'biblatex') opts.biblatex = true;
    if (resourceFiles.bibFile) opts.bibliography = resourceFiles.bibFile.name;
    if (method === 'citeproc') {
      if (resourceFiles.cslFile) opts.csl = resourceFiles.cslFile.name;
      if (resourceFiles.abbrevFile) opts['citation-abbreviations'] = resourceFiles.abbrevFile.name;
    }
  }

  // Math (wired later)
  const mathEl = document.getElementById('opt-math');
  if (mathEl && mathEl.value) {
    if (mathEl.value === 'mathjax4') {
      opts['html-math-method'] = {
        method: 'mathjax',
        url: 'https://cdn.jsdelivr.net/npm/mathjax@4/tex-mml-chtml.js'
      };
    } else if (mathEl.value === 'mathjax-omml' || mathEl.value === 'mathjax-mathml'
               || mathEl.value === 'mathjax-mathml-intent'
               || mathEl.value === 'epub-thorium') {
      // Handled by the MathJax device Lua filter (docx→OMML / html→MathML); no html-math-method.
    } else {
      opts['html-math-method'] = mathEl.value;
    }
  }

  // EPUB for Thorium Reader: NO html-math-method.
  //
  // Until 2026-08-14 this forced 'mathjax', which left the math as LaTeX for
  // read-time typesetting (Route A). It now runs the same conversion-time
  // device as HTML/DOCX (Route B): the math is already static MathML carrying
  // intent= and ext-* by the time Pandoc writes the EPUB, so setting a
  // math method here would be wrong -- there is no TeX left to typeset.
  //
  // The bundled MathJax still loads (via the spliced payload + header) to
  // render the MathML to SVG and to drive SRE speech/subtitles/explorer.
  // 'epub-thorium' is already in the no-op branch above, so nothing is set.

  // intent/SRE method: the filter injects through header-includes, which
  // Pandoc only renders in standalone mode. Non-standalone would emit a page
  // with no MathJax at all, so force it rather than fail silently.
  if (needsIntentFilter() && !opts.standalone) {
    console.log('[intent] forcing --standalone (header-includes are required)');
    opts.standalone = true;
  }

  // Code highlighting (wired later)
  const hlStyle = document.getElementById('opt-highlight-style');
  if (hlStyle) {
    if (hlStyle.value === 'custom' && resourceFiles.highlightThemeFile) {
      opts['highlight-style'] = resourceFiles.highlightThemeFile.name;
    } else if (hlStyle.value && hlStyle.value !== 'custom') {
      opts['highlight-style'] = hlStyle.value;
    }
  }
  if (resourceFiles.syntaxDefinitions.length > 0) {
    opts['syntax-definition'] = resourceFiles.syntaxDefinitions.map(f => f.name);
  }
  const indentCode = document.getElementById('opt-indented-code-classes');
  if (indentCode && indentCode.value.trim()) opts['indented-code-classes'] = indentCode.value.trim();

  // Format-specific (wired later — read whatever elements exist)
  const stripComments = document.getElementById('opt-strip-comments');
  if (stripComments && stripComments.checked) opts['strip-comments'] = true;
  const defImgExt = document.getElementById('opt-default-image-extension');
  if (defImgExt && defImgExt.value.trim()) opts['default-image-extension'] = defImgExt.value.trim();
  if (resourceFiles.abbreviationsFile) opts.abbreviations = resourceFiles.abbreviationsFile.name;

  // HTML-specific
  const selfContained = document.getElementById('opt-self-contained');
  if (selfContained && selfContained.checked) opts['embed-resources'] = true;
  const htmlQTags = document.getElementById('opt-html-q-tags');
  if (htmlQTags && htmlQTags.checked) opts['html-q-tags'] = true;
  const sectionDivs = document.getElementById('opt-section-divs');
  if (sectionDivs && sectionDivs.checked) opts['section-divs'] = true;
  const titlePrefix = document.getElementById('opt-title-prefix');
  if (titlePrefix && titlePrefix.value.trim()) opts['title-prefix'] = titlePrefix.value.trim();
  const idPrefix = document.getElementById('opt-id-prefix');
  if (idPrefix && idPrefix.value.trim()) opts['id-prefix'] = idPrefix.value.trim();
  const emailObfusc = document.getElementById('opt-email-obfuscation');
  if (emailObfusc && emailObfusc.value) opts['email-obfuscation'] = emailObfusc.value;
  if (resourceFiles.cssFiles.length > 0) opts.css = resourceFiles.cssFiles.map(f => f.name);

  // Markdown-specific
  const refLinks = document.getElementById('opt-reference-links');
  if (refLinks && refLinks.checked) opts['reference-links'] = true;
  const refLoc = document.getElementById('opt-reference-location');
  if (refLoc && refLoc.value) opts['reference-location'] = refLoc.value;
  const mdHeadings = document.getElementById('opt-markdown-headings');
  if (mdHeadings && mdHeadings.value) opts['markdown-headings'] = mdHeadings.value;

  // RST-specific
  const refLinksRst = document.getElementById('opt-reference-links-rst');
  if (refLinksRst && refLinksRst.checked) opts['reference-links'] = true;
  const listTables = document.getElementById('opt-list-tables');
  if (listTables && listTables.checked) opts['list-tables'] = true;

  // LaTeX-specific
  const lof = document.getElementById('opt-lof');
  if (lof && lof.checked) opts['list-of-figures'] = true;
  const lot = document.getElementById('opt-lot');
  if (lot && lot.checked) opts['list-of-tables'] = true;
  const topLevel = document.getElementById('opt-top-level-division');
  if (topLevel && topLevel.value) opts['top-level-division'] = topLevel.value;

  // Caption position
  const figCaption = document.getElementById('opt-figure-caption-position');
  if (figCaption && figCaption.value) opts['figure-caption-position'] = figCaption.value;
  const tblCaption = document.getElementById('opt-table-caption-position');
  if (tblCaption && tblCaption.value) opts['table-caption-position'] = tblCaption.value;

  // ASCII
  const ascii = document.getElementById('opt-ascii');
  if (ascii && ascii.checked) opts.ascii = true;
  const asciiHtml = document.getElementById('opt-ascii-html');
  if (asciiHtml && asciiHtml.checked) opts.ascii = true;

  // ODT
  const linkImages = document.getElementById('opt-link-images');
  if (linkImages && linkImages.checked) opts['link-images'] = true;

  // EPUB
  if (resourceFiles.epubCoverImage) opts['epub-cover-image'] = resourceFiles.epubCoverImage.name;
  if (resourceFiles.epubMetadataFile) opts['epub-metadata'] = resourceFiles.epubMetadataFile.name;
  if (resourceFiles.epubFonts.length > 0) opts['epub-fonts'] = resourceFiles.epubFonts.map(f => f.name);
  const epubTitle = document.getElementById('opt-epub-title-page');
  if (epubTitle && !epubTitle.checked) opts['epub-title-page'] = false;
  const epubSubdir = document.getElementById('opt-epub-subdirectory');
  if (epubSubdir && epubSubdir.value.trim()) opts['epub-subdirectory'] = epubSubdir.value.trim();

  // Chunked HTML
  const splitLevel = document.getElementById('opt-split-level');
  if (splitLevel && splitLevel.value) opts['split-level'] = parseInt(splitLevel.value);
  const chunkTemplate = document.getElementById('opt-chunk-template');
  if (chunkTemplate && chunkTemplate.value.trim()) opts['chunk-template'] = chunkTemplate.value.trim();

  // Notebook
  const ipynb = document.getElementById('opt-ipynb-output');
  if (ipynb && ipynb.value) opts['ipynb-output'] = ipynb.value;

  // Slides
  const slideLevel = document.getElementById('opt-slide-level');
  if (slideLevel && slideLevel.value) opts['slide-level'] = parseInt(slideLevel.value);
  const incremental = document.getElementById('opt-incremental');
  if (incremental && incremental.checked) opts.incremental = true;

  // Track changes
  const trackChanges = document.getElementById('opt-track-changes');
  if (trackChanges && trackChanges.value) opts['track-changes'] = trackChanges.value;

  // Template
  if (resourceFiles.templateFile) opts.template = resourceFiles.templateFile.name;
  if (resourceFiles.referenceDoc) opts['reference-doc'] = resourceFiles.referenceDoc.name;

  // Include files
  const headerNames = resourceFiles.headerFiles.map(f => f.name);
  if (thoriumPreset) headerNames.push(THORIUM_HEAD_NAME);
  if (headerNames.length > 0) opts['include-in-header'] = headerNames;
  if (resourceFiles.beforeBodyFiles.length > 0) opts['include-before-body'] = resourceFiles.beforeBodyFiles.map(f => f.name);
  if (resourceFiles.afterBodyFiles.length > 0) opts['include-after-body'] = resourceFiles.afterBodyFiles.map(f => f.name);

  // Wrapping (wired later)
  const wrapEl = document.getElementById('opt-wrap');
  if (wrapEl && wrapEl.value !== 'auto') opts.wrap = wrapEl.value;
  const colsEl = document.getElementById('opt-columns');
  if (colsEl && colsEl.value.trim()) opts.columns = parseInt(colsEl.value);

  // Metadata key/value pairs
  const metaRows = document.querySelectorAll('#panel-metadata .opt-kv-row');
  if (metaRows.length > 0) {
    const metadata = {};
    metaRows.forEach(row => {
      const inputs = row.querySelectorAll('input[type="text"]');
      const key = inputs[0]?.value.trim();
      const val = inputs[1]?.value.trim();
      if (key && val) {
        metadata[key] = key === 'author' ? [val] : val;
      }
    });
    if (Object.keys(metadata).length > 0) opts.metadata = metadata;
  }
  if (resourceFiles.metadataFile) opts['metadata-file'] = resourceFiles.metadataFile.name;

  // Template variables key/value pairs
  const varRows = document.querySelectorAll('#panel-template .opt-kv-row');
  if (varRows.length > 0) {
    const variables = {};
    varRows.forEach(row => {
      const inputs = row.querySelectorAll('input[type="text"]');
      const key = inputs[0]?.value.trim();
      const val = inputs[1]?.value.trim();
      if (key && val) variables[key] = val;
    });
    if (Object.keys(variables).length > 0) opts.variables = variables;
  }

  // Lua filters — unified ordering of built-in + user filters
  {
    const filterNames = [];
    syncFilterOrder();
    for (const entry of filterOrder) {
      if (entry.type === 'builtin') {
        if (builtInState[entry.id]) {
          const def = BUILT_IN_FILTERS.find(f => f.id === entry.id);
          if (def) filterNames.push(def.filename);
        }
      } else {
        if (userFilterState[entry.idx] !== false) {
          const f = resourceFiles.luaFilters[entry.idx];
          if (f) filterNames.push(f.name);
        }
      }
    }
    // Intent/SRE filter — MUST precede the device filter: _mjx-math.lua
    // replaces every Math element with a placeholder RawInline, so anything
    // running after it sees no math and injects nothing.
    if (needsIntentFilter()) filterNames.push(INTENT_FILTER_NAME);
    // MathJax device filter (docx→OMML / html→MathML) — appended last so it runs after other filters
    if (needsMathjaxDevice()) filterNames.push('_mjx-math.lua');
    if (filterNames.length > 0) opts.filters = filterNames;
  }

  // Output file — always set so pandoc writes to virtual filesystem
  const baseToFmt = toFmt.split(/[+-]/)[0]; // strip extensions
  const outExt = EXTENSION_BY_FORMAT[baseToFmt] || baseToFmt;
  opts['output-file'] = `${inputFileName}.${outExt}`;

  // Binary input — use input-files instead of stdin
  if (inputBinaryFile) {
    opts['input-files'] = [inputBinaryFile.name];
  }

  return opts;
}

// --- Build files object for pandoc.convert() ---
function buildFiles() {
  const raw = {};
  // Collect all resource files
  Object.entries(resourceFiles.auxFiles).forEach(([name, data]) => { raw[name] = data; });
  if (resourceFiles.bibFile) raw[resourceFiles.bibFile.name] = resourceFiles.bibFile;
  if (resourceFiles.cslFile) raw[resourceFiles.cslFile.name] = resourceFiles.cslFile;
  if (resourceFiles.abbrevFile) raw[resourceFiles.abbrevFile.name] = resourceFiles.abbrevFile;
  if (resourceFiles.abbreviationsFile) raw[resourceFiles.abbreviationsFile.name] = resourceFiles.abbreviationsFile;
  resourceFiles.cssFiles.forEach(f => { raw[f.name] = f; });
  if (resourceFiles.highlightThemeFile) raw[resourceFiles.highlightThemeFile.name] = resourceFiles.highlightThemeFile;
  resourceFiles.syntaxDefinitions.forEach(f => { raw[f.name] = f; });
  if (resourceFiles.templateFile) raw[resourceFiles.templateFile.name] = resourceFiles.templateFile;
  if (resourceFiles.referenceDoc) raw[resourceFiles.referenceDoc.name] = resourceFiles.referenceDoc;
  if (resourceFiles.metadataFile) raw[resourceFiles.metadataFile.name] = resourceFiles.metadataFile;
  if (resourceFiles.epubCoverImage) raw[resourceFiles.epubCoverImage.name] = resourceFiles.epubCoverImage;
  if (resourceFiles.epubMetadataFile) raw[resourceFiles.epubMetadataFile.name] = resourceFiles.epubMetadataFile;
  resourceFiles.epubFonts.forEach(f => { raw[f.name] = f; });
  resourceFiles.headerFiles.forEach(f => { raw[f.name] = f; });
  resourceFiles.beforeBodyFiles.forEach(f => { raw[f.name] = f; });
  resourceFiles.afterBodyFiles.forEach(f => { raw[f.name] = f; });
  resourceFiles.luaFilters.forEach(f => { raw[f.name] = f; });
  // Include enabled built-in filter content as virtual files
  BUILT_IN_FILTERS.forEach(f => {
    if (builtInState[f.id]) {
      raw[f.filename] = new Blob([f.content], { type: 'text/plain' });
    }
  });
  // MathJax device filter content (docx→OMML / html→MathML)
  if (needsMathjaxDevice()) raw['_mjx-math.lua'] = new Blob([MJX_MATH_LUA], { type: 'text/plain' });
  // Intent/SRE filter source, fetched from ./filters/ (not embedded)
  if (needsIntentFilter() && intentFilterSource) raw[INTENT_FILTER_NAME] = new Blob([intentFilterSource], { type: 'text/plain' });
  // Thorium preset: virtual header carrying the MathJax bootstrap
  if (isThoriumPreset() && thoriumAssets.headHtml) raw[THORIUM_HEAD_NAME] = new Blob([thoriumAssets.headHtml], { type: 'text/html' });
  // Binary input file
  if (inputBinaryFile) raw[inputBinaryFile.name] = inputBinaryFile.blob;
  // pandoc.js expects Blob objects (calls blob.arrayBuffer())
  const files = {};
  for (const [name, data] of Object.entries(raw)) {
    files[name] = (data instanceof Blob) ? data : new Blob([data]);
  }
  return files;
}

// ── MathJax → OMML / MathML tier-1 device ───────────────────────────
// Batched, target-aware Lua filter: collect all math, one device transaction,
// reinsert as RawInline. Target is chosen from the output FORMAT (omml→docx,
// mathml→html); the device transform (set below) branches to match.
const MJX_MATH_LUA = `
local PREFIX = 'MJXDEV:'
local collected = {}
local target, rawfmt
if FORMAT:match('docx') then target = 'omml'; rawfmt = 'openxml'
elseif FORMAT:match('html') then target = 'mathml'; rawfmt = 'html'
elseif FORMAT:match('epub') then target = 'mathml'; rawfmt = 'html' end
function Math(el)
  if not target then return nil end
  local i = #collected + 1
  collected[i] = { tex = el.text, display = (el.mathtype == 'DisplayMath') }
  return pandoc.RawInline(rawfmt, PREFIX .. i)
end
function Pandoc(doc)
  if not target or #collected == 0 then return doc end
  local payload = pandoc.json.encode({ target = target, items = collected })
  local fw = io.open('xform','w'); if not fw then io.stderr:write('MJX-DEV-W-FAIL'); return doc end
  fw:write(payload); fw:close()
  local fr = io.open('xform','r'); if not fr then io.stderr:write('MJX-DEV-R-FAIL'); return doc end
  local out = fr:read('a'); fr:close()
  local ok, results = pcall(pandoc.json.decode, out)
  if not ok then io.stderr:write('MJX-DEV-BADJSON'); return doc end
  return doc:walk {
    RawInline = function(el)
      local n = el.text:match('^' .. PREFIX .. '(%d+)$')
      if n then return pandoc.RawInline(rawfmt, results[tonumber(n)]) end
    end
  }
end
`;

let _mjxDeviceReady = null;
function needsMathjaxDevice() {
  const m = document.getElementById('opt-math')?.value;
  const to = document.getElementById('selTo').value.split(/[+-]/)[0];
  return (m === 'mathjax-omml' && to === 'docx') ||
         ((m === 'mathjax-mathml' || m === 'mathjax-mathml-intent')
          && (isHtmlFamily(to) || isEpubFamily(to))) ||
         // Thorium preset is Route B as of 2026-08-14: the device bakes static
         // MathML (intent= + ext-*) at conversion time, and the bundled MathJax
         // takes MathML as INPUT. Previously this returned false and the EPUB
         // shipped raw LaTeX, so \intent was undefined at read time.
         (m === 'epub-thorium' && isEpubFamily(to));
}
function ensureMathjaxDevice() {
  if (!_mjxDeviceReady) {
    _mjxDeviceReady = (async () => {
      const [{ tex2mml }, cond, { rewriteIsotopes }] = await Promise.all([
        // 2026-08-09: intent-aware bundle (adds \intent/\iarg/\speakas + the
        // vocabulary shortcut macros; no-intent sources convert IDENTICALLY —
        // byte-parity verified). Built by mathjax-intent-extension
        // build/bundle/. To revert, point back at './math-conversion/mathjax-bundle.js'.
        import('./math-conversion/mathjax-bundle-intent.js'),
        import('./math-conversion/mml-condition.js'),
        import('./math-conversion/mml-isotopes-browser.js'),
      ]);
      const { conditionForOmml, conditionUniversal } = cond;
      const xslText = await (await fetch('math-conversion/MML2OMML.XSL')).text();
      const proc = new XSLTProcessor();
      proc.importStylesheet(new DOMParser().parseFromString(xslText, 'application/xml'));
      const enc = new TextEncoder(), dec = new TextDecoder();
      const mmlToOmml = (mml) => {
        const d = new DOMParser().parseFromString(mml, 'application/xml');
        return new XMLSerializer().serializeToString(proc.transformToFragment(d, document));
      };
      const OMML_ERR = '<m:oMath xmlns:m="http://schemas.openxmlformats.org/officeDocument/2006/math"><m:r><m:t>?</m:t></m:r></m:oMath>';
      const MML_ERR = '<math xmlns="http://www.w3.org/1998/Math/MathML"><merror><mtext>?</mtext></merror></math>';
      pandocModule.setDeviceTransform((bytes) => {
        const batch = JSON.parse(dec.decode(bytes));
        const items = batch.items || [];
        const out = items.map((it) => {
          try {
            const mml = tex2mml(it.tex, it.display);
            return batch.target === 'omml'
              ? mmlToOmml(rewriteIsotopes(conditionForOmml(mml)))
              : conditionUniversal(mml);
          } catch (e) {
            return batch.target === 'omml' ? OMML_ERR : MML_ERR;
          }
        });
        return enc.encode(JSON.stringify(out));
      });
    })();
  }
  return _mjxDeviceReady;
}


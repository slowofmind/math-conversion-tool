  // Hide all option panels, then show the first panel for the active engine
  document.querySelectorAll('.options-tab-panel').forEach(p => {
    p.classList.remove('active');
    p.style.display = 'none';
  });

  // Activate the first tab in the active engine's tab row
  const activeRow = document.getElementById(tabRows[engine]);
  const firstTab = activeRow.querySelector('.options-tab');
  if (firstTab) {
    activeRow.querySelectorAll('.options-tab').forEach(t => {
      t.classList.remove('active');
      t.setAttribute('aria-selected', 'false');
      t.setAttribute('tabindex', '-1');
    });
    firstTab.classList.add('active');
    firstTab.setAttribute('aria-selected', 'true');
    firstTab.setAttribute('tabindex', '0');
    const firstPanel = document.getElementById('panel-' + firstTab.dataset.tab);
    if (firstPanel) {
      firstPanel.style.display = '';
      firstPanel.classList.add('active');
    }
  }

  // Lock/unlock From/To dropdowns
  const selFrom = document.getElementById('selFrom');
  const selTo = document.getElementById('selTo');

  if (engine === 'pandoc') {
    // Unlock dropdowns, restore defaults
    selFrom.disabled = false;
    selFrom.style.opacity = '';
    selTo.disabled = false;
    selTo.style.opacity = '';
    selFrom.value = pandocDefaultFrom;
    selTo.value = pandocDefaultTo;
    updateExtensions();
    refreshMathOptions();
  } else if (engine === 'latexml') {
    selFrom.value = 'latex';
    selFrom.disabled = true;
    selFrom.style.opacity = '0.5';
    selTo.value = 'html5';
    selTo.disabled = true;
    selTo.style.opacity = '0.5';
  } else if (engine === 'lualatex') {
    selFrom.value = 'latex';
    selFrom.disabled = true;
    selFrom.style.opacity = '0.5';
    // Temporarily add pdf option if not present
    let pdfOpt = selTo.querySelector('option[value="pdf"]');
    if (!pdfOpt) {
      pdfOpt = document.createElement('option');
      pdfOpt.value = 'pdf';
      pdfOpt.textContent = 'pdf';
      selTo.appendChild(pdfOpt);
    }
    selTo.value = 'pdf';
    selTo.disabled = true;
    selTo.style.opacity = '0.5';
  }

  // Update Convert button state
  const convertBtn = document.getElementById('btnConvert');
  if (engine === 'pandoc') {
    convertBtn.disabled = !pandocModule;
    convertBtn.textContent = 'Convert';
  } else {

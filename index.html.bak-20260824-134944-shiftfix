// --- Generic tab switching (works on any tab row) ---
function activateOptionsTab(tab) {
  const tabName = tab.dataset.tab;
  // Find the parent tab row and deactivate all its tabs
  const tabRow = tab.closest('.options-tabs');
  if (tabRow) {
    tabRow.querySelectorAll('.options-tab').forEach(t => {
      t.classList.remove('active');
      t.setAttribute('aria-selected', 'false');
      t.setAttribute('tabindex', '-1');
    });
  }
  // Hide all option panels (across all engines)
  document.querySelectorAll('.options-tab-panel').forEach(p => {
    p.classList.remove('active');
    p.style.display = 'none';
  });
  // Activate clicked tab and its panel
  tab.classList.add('active');
  tab.setAttribute('aria-selected', 'true');
  tab.setAttribute('tabindex', '0');
  tab.focus();
  const panel = document.getElementById('panel-' + tabName);
  if (panel) {
    panel.style.display = '';
    panel.classList.add('active');
  }
}

// Attach click + keyboard handlers to all three tab rows
['pandocOptionsTabs', 'latexmlOptionsTabs', 'lualatexOptionsTabs'].forEach(rowId => {
  const row = document.getElementById(rowId);
  if (!row) return;
  row.addEventListener('click', (e) => {
    const tab = e.target.closest('.options-tab');
    if (!tab) return;
    activateOptionsTab(tab);
  });
  row.addEventListener('keydown', (e) => {
    const tabs = [...row.querySelectorAll('.options-tab')];
    const current = tabs.indexOf(e.target);
    if (current < 0) return;
    let next;
    if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
      e.preventDefault();
      next = tabs[(current + 1) % tabs.length];
    } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
      e.preventDefault();
      next = tabs[(current - 1 + tabs.length) % tabs.length];
    } else if (e.key === 'Home') {
      e.preventDefault();
      next = tabs[0];
    } else if (e.key === 'End') {
      e.preventDefault();
      next = tabs[tabs.length - 1];
    }
    if (next) activateOptionsTab(next);
  });
});


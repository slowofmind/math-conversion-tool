// SECTION 12: REMOTE CONVERSION (LaTeXML via GitHub Actions)
// ════════════════════════════════════════════════════════════════════
//
// Architecture:
//   1. User clicks "LaTeXML" → JS commits .tex to latexml-pipeline-input/ via GitHub API
//   2. Push triggers the latexml-convert.yml workflow on github.com
//   3. Workflow runs LaTeXML in Docker, commits HTML output to latexml-pipeline-output/
//   4. JS polls for workflow completion, then fetches the HTML result
//   5. Result is displayed in the existing preview/source panels
//
// Authentication: requires a GitHub PAT with repo + actions scopes,
// stored in localStorage after the user enters it once.

const GITHUB_REPO_OWNER = 'slowofmind';
const GITHUB_REPO_NAME = 'math-conversion-tool';
const GITHUB_API_BASE = `https://api.github.com/repos/${GITHUB_REPO_OWNER}/${GITHUB_REPO_NAME}`;

// --- PAT management (localStorage + embedded service token) ---

// ============================================================================
// TOKEN SLOT - intentionally empty.
// ============================================================================
// This is where the GitHub Personal Access Token would go IF the Docker-based
// LaTeXML / LuaLaTeX conversion via GitHub Actions were re-enabled.
//
// The pipeline code is all still present and functional; only the token and
// the engine buttons that reached it have been removed. Restoring the feature
// means (a) putting a valid fine-grained PAT below, and (b) un-hiding the
// engine buttons in the toolbar markup (search: ENGINE BUTTONS HIDDEN).
//
// Required PAT scopes, limited to the pipeline repo only:
//     contents:write   commit the .tex file (NOTE: also grants repo read)
//     actions:read     poll workflow runs, download artifacts
//
// SECURITY: anything placed here is readable by every visitor who can load
// this page - client-side JavaScript cannot hide a secret. The previous token
// is in git history and should be treated as compromised. Prefer a server-side
// proxy that holds the credential, or per-user tokens via the right-click
// prompt (promptForGitHubToken), over embedding one here again.
//
// Leave as an empty string to keep the pipeline engines inert.
const SERVICE_TOKEN = '';

function getGitHubToken() {
  // User-provided token takes priority over service token
  return localStorage.getItem('github-pat') || SERVICE_TOKEN || null;
}

function hasServiceToken() {
  return SERVICE_TOKEN && SERVICE_TOKEN !== 'PASTE_YOUR_TOKEN_HERE';
}

function saveGitHubToken(token) {
  localStorage.setItem('github-pat', token);
}

function promptForGitHubToken() {
  const current = localStorage.getItem('github-pat') || '';
  const token = prompt(
    'Enter your own GitHub Personal Access Token (PAT) to override the built-in token.\n\n' +
    'Required scopes: repo, actions\n' +
    'Generate one at: github.com/settings/tokens\n\n' +
    'Leave blank and click OK to revert to the built-in token.',
    current
  );
  if (token === null) return null; // cancelled
  if (token.trim()) {
    saveGitHubToken(token.trim());
    return token.trim();
  } else {
    // Cleared — remove personal token, fall back to service token
    localStorage.removeItem('github-pat');
    return getGitHubToken();
  }
}

// --- GitHub API helper ---

async function githubAPI(endpoint, options = {}) {
  const token = getGitHubToken();
  if (!token) throw new Error('No GitHub token configured');

  const url = endpoint.startsWith('http')
    ? endpoint
    : `${GITHUB_API_BASE}${endpoint}`;

  const resp = await fetch(url, {
    ...options,
    headers: {
      'Authorization': `token ${token}`,
      'Accept': 'application/vnd.github+json',
      'X-GitHub-Api-Version': '2022-11-28',
      ...(options.headers || {}),
    },
  });

  if (!resp.ok) {
    const body = await resp.text();
    throw new Error(`GitHub API ${resp.status}: ${body}`);
  }

  return resp.json();
}

// --- Commit a file to the repo via the Contents API ---

async function commitFileToRepo(path, contentString, commitMessage) {
  // Check if file already exists (need its SHA for update)
  let existingSha = null;
  try {
    const existing = await githubAPI(`/contents/${path}`);
    existingSha = existing.sha;
  } catch (_) {
    // File doesn't exist yet — that's fine
  }

  // Base64-encode the content (handles UTF-8 correctly)
  const encoder = new TextEncoder();
  const bytes = encoder.encode(contentString);
  let binary = '';
  for (let i = 0; i < bytes.length; i++) binary += String.fromCharCode(bytes[i]);
  const base64Content = btoa(binary);

  const body = {
    message: commitMessage,
    content: base64Content,
  };
  if (existingSha) body.sha = existingSha;

  const result = await githubAPI(`/contents/${path}`, {
    method: 'PUT',
    body: JSON.stringify(body),
  });

  return result.commit.sha;
}

// --- Poll for workflow run completion ---

async function waitForWorkflowRun(commitSha, timeoutMs = 300000) {
  const POLL_INTERVAL = 5000;  // 5 seconds between checks
  const startTime = Date.now();

  // Give GitHub a moment to create the run
  await new Promise(r => setTimeout(r, 4000));

  while (Date.now() - startTime < timeoutMs) {
    try {
      const runs = await githubAPI('/actions/runs?per_page=10&branch=main');

      // Find the run triggered by our specific commit
      const run = runs.workflow_runs.find(r => r.head_sha === commitSha);

      if (run) {
        if (run.status === 'completed') {
          return run;
        }
        // Show progress in status bar
        const elapsed = Math.round((Date.now() - startTime) / 1000);
        updateStatus('loading', `LaTeXML: ${run.status} (${elapsed}s)…`);
      } else {
        updateStatus('loading', 'LaTeXML: waiting for workflow to start…');
      }
    } catch (err) {
      console.warn('Polling error (will retry):', err.message);
    }

    await new Promise(r => setTimeout(r, POLL_INTERVAL));
  }

  throw new Error('Workflow timed out after 5 minutes');
}

// --- Fetch an output file from the repo via Contents API ---

async function fetchRepoFile(path) {
  const file = await githubAPI(`/contents/${path}`);
  // Contents API returns base64 — decode it
  const raw = atob(file.content.replace(/\n/g, ''));
  // Convert back to UTF-8 string
  const bytes = new Uint8Array(raw.length);
  for (let i = 0; i < raw.length; i++) bytes[i] = raw.charCodeAt(i);
  return new TextDecoder().decode(bytes);
}

// --- List files in a repo directory ---

async function listRepoDir(path) {
  try {
    const items = await githubAPI(`/contents/${path}`);
    if (Array.isArray(items)) return items.map(i => i.name);
  } catch (_) {}
  return [];
}

// --- Main LaTeXML conversion flow ---

async function runLatexmlConversion() {
  // Restore iframe sandbox in case previous output was a PDF
  restoreHtmlPreview();

  // Ensure we have a token (service token or user-provided)
  let token = getGitHubToken();
  if (!token) {
    // No service token and no user token — prompt
    token = promptForGitHubToken();
    if (!token) {
      updateStatus('error', 'GitHub token required for LaTeXML conversion');
      return;
    }
  }

  const btn = document.getElementById('btnConvert');
  const sourceText = inputBinaryFile ? null : getSourceForConversion();

  if (!sourceText || !sourceText.trim()) {
    updateStatus('error', 'No LaTeX source to convert');
    return;
  }

  // Check that input looks like LaTeX
  if (!sourceText.includes('\\documentclass') && !sourceText.includes('\\begin{document}')) {
    const proceed = confirm(
      'The source does not appear to contain \\documentclass.\n' +
      'LaTeXML requires a complete LaTeX document. Continue anyway?'
    );
    if (!proceed) return;
  }

  btn.disabled = true;
  btn.textContent = 'Converting…';
  clearDecorations();

  // Use a timestamp to create a unique filename and avoid collisions
  const timestamp = Date.now();
  const baseName = inputFileName || 'untitled';
  const texFilename = `${baseName}-${timestamp}.tex`;

  // Determine which output variant to fetch based on dropdown
  const latexmlMathMode = document.getElementById('opt-latexml-math').value;
  const variantSuffix = latexmlMathMode === 'mathjax4' ? 'mathjax4' : 'mathml';
  const variantLabel = latexmlMathMode === 'mathjax4' ? 'MathJax 4' : 'MathML';
  const expectedOutput = `${baseName}-${timestamp}-${variantSuffix}.html`;

  try {
    // Step 1: Commit the .tex file to latexml-pipeline-input/
    updateStatus('loading', 'LaTeXML: uploading source…');
    const commitSha = await commitFileToRepo(
      `latexml-pipeline-input/${texFilename}`,
      sourceText,
      `LaTeXML: ${baseName}.tex`
    );
    console.log('[latexml] Committed latexml-pipeline-input/' + texFilename, 'SHA:', commitSha);

    // Step 2: Wait for the GitHub Actions workflow to complete
    updateStatus('loading', 'LaTeXML: workflow queued…');
    const run = await waitForWorkflowRun(commitSha);

    if (run.conclusion !== 'success') {
      const runUrl = run.html_url;
      throw new Error(
        `Workflow ${run.conclusion}. ` +
        `Check the Actions tab for details: ${runUrl}`
      );
    }
    console.log('[latexml] Workflow completed:', run.html_url);

    // Step 3: Fetch the HTML output
    updateStatus('loading', 'LaTeXML: fetching results…');

    // The pipeline might take a moment to push output back — poll briefly
    let outputHtml = null;
    for (let attempt = 0; attempt < 6; attempt++) {
      try {
        // Try the expected filename first
        outputHtml = await fetchRepoFile(`latexml-pipeline-output/${expectedOutput}`);
        break;
      } catch (_) {
        // Workflow commit might not have propagated yet, or filename differs
        if (attempt < 5) {
          await new Promise(r => setTimeout(r, 3000));
        }
      }
    }

    // If exact filename didn't work, scan the directory for our output
    if (!outputHtml) {
      const files = await listRepoDir('latexml-pipeline-output');
      // Look for the selected variant HTML file that matches our base name
      const match = files.find(f =>
        f.includes(baseName) && f.includes(variantSuffix) && f.endsWith('.html')
      );
      if (match) {
        outputHtml = await fetchRepoFile(`latexml-pipeline-output/${match}`);
      }
    }

    if (!outputHtml) {
      throw new Error(
        'Conversion completed but output file not found. ' +
        'Check the repo\'s latexml-pipeline-output/ folder and the Actions tab.'
      );
    }

    // Step 4: Display results in the output panel
    sourceEditor.setText(outputHtml);
    sourceEditor.setLanguage('html');

    const previewFrame = document.getElementById('previewFrame');
    previewFrame.srcdoc = outputHtml;

    // Store for download
    const blob = new Blob([outputHtml], { type: 'text/html' });
    const sizeKB = (blob.size / 1024).toFixed(1);
    const downloadName = `${baseName}-latexml-${variantSuffix}.html`;
    lastOutput = { blob, filename: downloadName };

    const downloadBtn = document.getElementById('btnDownloadOutput');
    downloadBtn.textContent = `📥 ${downloadName} (${sizeKB} KB)`;
    downloadBtn.style.display = '';

    // Show SCORM button for HTML output
    document.getElementById('btnDownloadScorm').style.display = '';

    // Update log
    updateLog([{
      line: null, column: null, level: 'info',
      message: `LaTeXML conversion complete (${sizeKB} KB, ${variantLabel}). Output: ${downloadName}`,
      matchedText: null, type: 'latexml-success',
    }], '');

    updateStatus('ready', `LaTeXML: converted (${sizeKB} KB, ${variantLabel})`);

  } catch (err) {
    console.error('[latexml] Error:', err);
    updateStatus('error', `LaTeXML: ${err.message.substring(0, 80)}`);
    updateLog([{
      line: null, column: null, level: 'error',
      message: `LaTeXML conversion failed: ${err.message}`,
      matchedText: null, type: 'latexml-error',
    }], '');
  } finally {
    btn.disabled = false;
    btn.textContent = 'Convert';
  }
}


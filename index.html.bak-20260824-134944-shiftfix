function renderExtensionsList(containerId, extList, extState, direction) {
  const container = document.getElementById(containerId);
  if (!container) return;
  if (extList.length === 0) {
    container.innerHTML = '<span style="color:var(--text-muted);font-size:11px;">No extensions available</span>';
    return;
  }
  container.innerHTML = '';
  for (const ext of extList) {
    const isChecked = extState[ext.name] !== undefined ? extState[ext.name] : ext.defaultOn;
    const isToggled = extState[ext.name] !== undefined;
    const item = document.createElement('div');
    item.className = 'ext-item' + (ext.defaultOn ? ' default-on' : '') + (isToggled ? ' toggled' : '');
    const id = `ext-${direction}-${ext.name}`;
    item.innerHTML = `<input type="checkbox" id="${id}" ${isChecked ? 'checked' : ''}>` +
      `<label for="${id}">${ext.name}</label>`;
    item.querySelector('input').addEventListener('change', (e) => {
      if (e.target.checked !== ext.defaultOn) {
        extState[ext.name] = e.target.checked;
      } else {
        delete extState[ext.name];
      }
      // Re-render to update toggled styling
      renderExtensionsList(containerId, extList, extState, direction);
    });
    container.appendChild(item);
  }
}

function buildFormatWithExtensions(baseFormat, extState) {
  if (!baseFormat) return baseFormat;
  let formatStr = baseFormat;
  for (const [ext, enabled] of Object.entries(extState)) {
    if (enabled === true) formatStr += `+${ext}`;
    else if (enabled === false) formatStr += `-${ext}`;
  }
  return formatStr;
}


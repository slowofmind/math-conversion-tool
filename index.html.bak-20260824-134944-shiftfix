  .output-body { flex: 1; overflow: auto; background: var(--bg-primary); }

  .tab-content { display: none; height: 100%; }
  .tab-content.active { display: flex; flex-direction: column; }

  /* Preview iframe */
  #previewFrame { flex: 1; border: none; background: #fff; }

  /* Source tab editor (CM6 container) */
  #outputSource { flex: 1; min-height: 0; overflow: hidden; position: relative; }
  #outputSource .cm-editor { height: 100%; }

  /* Log tab */
  .log-container {
    flex: 1;
    overflow: auto;
    padding: 8px 12px;
    font-family: 'Roboto Mono', monospace;
    font-size: 12px;
    line-height: 1.7;
  }

  .log-entry {
    display: flex;
    gap: 8px;
    align-items: flex-start;
    cursor: pointer;
    border-radius: 3px;
    padding: 2px 6px;
    margin: 1px 0;
  }
  .log-entry:hover { background: var(--bg-tertiary); }
  .log-entry.active { background: var(--accent-glow); }

  .log-level {
    flex-shrink: 0;
    font-weight: 600;
    font-size: 11px;

% allow circling of items
\usepackage{fancybox}

\provideboolean{doCircle}
\setboolean{doCircle}{false}
\cornersize{1}

\newcommand{\circleitem}{\setboolean{doCircle}{true}\item\setboolean{doCircle}{false}}
\newcommand{\plainitem}{\setboolean{doCircle}{false}\item}

\newcommand{\maybecircle}[2][\boolean{doCircle}]{\probonly{#2}\solonly{\ifthenelse{#1}{\ifmmode\ovalbox{$\displaystyle #2$}\else\ovalbox{#2}\fi\hspace{-\fboxrule}\hspace{-\fboxsep}}{#2}}}
\usepackage[nointegrals]{wasysym}
\provideboolean{doBubble}
\setboolean{doBubble}{false}
\newcommand{\maybebubble}[1][\boolean{doBubble}]{{\Large\probonly{$\Circle$}\solonly{\ifthenelse{#1}{$\CIRCLE$}{$\Circle$}}}}
%\newcommand{\maybebubble}[1][\boolean{doBubble}]{\Large\probonly{$\Circle$}\solonly{\ifthenelse{#1}{$\CIRCLE$}\else{$\Circle$}\fi}}


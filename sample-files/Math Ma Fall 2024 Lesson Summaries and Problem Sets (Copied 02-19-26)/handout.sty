% true-false
\def\c@encoding{\f@encoding}% save current encoding in \c@encoding
\def\c@family{\f@family}%
\def\c@series{\f@series}%
\def\c@shape{\f@shape}%
\tffont\selectfont
\newlength{\@twidth}
\settowidth{\@twidth}{True}
\newlength{\@fwidth}
\settowidth{\@fwidth}{False}
\usefont{\c@encoding}{\c@family}{\c@series}{\c@shape}\selectfont%
\provideboolean{answerTrue}
\newcommand{\tfheading}{
  \def\c@encoding{\f@encoding}% save current encoding in \c@encoding
  \def\c@family{\f@family}%
  \def\c@series{\f@series}%
  \def\c@shape{\f@shape}%
  \tffont\selectfont%
  \item[] True\hspace{0.1in}False}
  
\newenvironment{tf}[1]{%
  \ifthenelse%
  {\(\equal{\firstChar{#1}}{\firstChar{T}}\)\OR\(\equal{\firstChar{#1}}{\firstChar{t}}\)}%
  {\setboolean{answerTrue}{true}}%
  {\setboolean{answerTrue}{false}}%
  \parbox[t]{\@twidth}{\centering\maybebubble[\boolean{answerTrue}]}\hspace{0.1in}\parbox[t]{\@fwidth}{\centering\maybebubble[\NOT\boolean{answerTrue}]}\hspace{0.1in}%
  \def\c@encoding{\f@encoding}% save current encoding in \c@encoding
  \def\c@family{\f@family}%
  \def\c@series{\f@series}%
  \def\c@shape{\f@shape}%
  \solonly{\tffont\selectfont}% change font  
  \begin{minipage}[t]{\linewidth-\@twidth-\@fwidth-15pt} \setlength{\parskip}{8pt}}%  
  {\end{minipage}%
  \usefont{\c@encoding}{\c@family}{\c@series}{\c@shape}\selectfont%
  \bigskip}

% if the nospace option is used, don't show problem space
\DeclareOption{nospace}{%
  \renewenvironment{problem}[1][0pt]{}{}
  \renewcommand{\pspace}[1]{}
  \renewcommand{\pspacestar}[1]{}
  \renewcommand{\continueproblem}[1]{}
  \PassOptionsToPackage{\CurrentOption}{exam}
}

% if the option sols is used, display problems in italicized font and
% display solutions
\DeclareOption{sols}{%
  \renewenvironment{problem}[1][0in]%
  {\def\c@encoding{\f@encoding}% save current encoding in \c@encoding
    \def\c@family{\f@family}%
    \def\c@series{\f@series}%
    \def\c@shape{\f@shape}%
    \problemfont\selectfont% change font
    \colorlet{tikzcolor}{problemtikzcolor}% change TikZ color
  }%
  {\usefont{\c@encoding}{\c@family}{\c@series}{\c@shape}\selectfont}% restore original shape
  %
  \renewenvironment{solution}{\def\c@encoding{\f@encoding}% save current encoding in \c@encoding
    \def\c@family{\f@family}%
    \def\c@series{\f@series}%
    \def\c@shape{\f@shape}%
    \solutionfont\selectfont% change font
    \textbf{Solution.}}%
  {\usefont{\c@encoding}{\c@family}{\c@series}{\c@shape}\selectfont}% restore original shape
  \let\problemonly=\comment
  \let\endproblemonly=\endcomment
  \renewcommand{\pspace}[1]{}
  \renewenvironment{solutiononly}{}{}
  \renewcommand{\probonly}[1]{}
  \renewcommand{\solonly}[1]{#1}
  \let\learningCheck=\comment
  \let\endlearningCheck=\endcomment
  \makeatletter
  \setboolean{handout@showsols}{true}
  \makeatother  
}


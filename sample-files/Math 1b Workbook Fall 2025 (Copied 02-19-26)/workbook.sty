\def\pr@m@s{%
  \ifx'\@let@token
    \expandafter\pr@@@s
  \else
    \ifx^\@let@token
      \expandafter\expandafter\expandafter\pr@@@t
    \else
      \expandafter\expandafter\expandafter\pr@@@end
    \fi
  \fi}
\def\pr@@@end{\egroup
    \@ifnextchar({\mkern-2mu }{\@ifnextchar\{{\mkern-2mu }{\@ifnextchar[{\mkern-.5mu }{}}}}

\newcommand{\mquote}[1]{{\mathpalette\mqu@te{#1}}}

\newcommand{\mqu@te}[2]{%
  \sbox0{$\m@th#1\text{``}$}%
  \sbox2{$\m@th#1\text{''}$}%
  \sbox4{$\m@th#1#2$}%
  \ifdim\ht4>\dimexpr\ht0+1pt\relax
    \raisebox{\dimexpr\ht4-\height}{\box0}%
    #2%
    \raisebox{\dimexpr\ht4-\height}{\box2}%
  \else
    \box0 #2\box2
  \fi
}
\makeatother


% Get page, section, and chapter number from reference data in main.aux
\RequirePackage{refcount}
\RequirePackage{titlesec}
\RequirePackage{xstring}
\newcommand{\setcounterrefbeforedot}[2]{%
  \begingroup
  \StrBefore{\getrefnumber{#2}}{.}[\setcountertoreftemp]%
  \setcounter{#1}{\setcountertoreftemp}%
  \endgroup
}
\newcommand{\setcounterrefafterdot}[2]{%
  \begingroup
  \StrBehind{\getrefnumber{#2}}{.}[\setcountertoreftemp]%
  \setcounter{#1}{\setcountertoreftemp}%
  \endgroup
}
\newcommand{\numbering}[1]{
\setcounterpageref{page}{m-#1}
\setcounterrefbeforedot{chapter}{m-#1}
\setcounterrefafterdot{section}{m-#1}
\addtocounter{section}{-1}
}


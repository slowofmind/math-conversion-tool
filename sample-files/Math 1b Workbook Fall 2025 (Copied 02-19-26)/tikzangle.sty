%% File: tikzangle.sty
%% -------------------
%% This package will draw an angle in standard position.  The basic usage
%% is
%%     \begin{tikzangle}[angle=5*pi/6]
%%     \end{tikzangle}
%% The angle should be specified in radians.
%% 
%% Options are:
%% * color: what color the angle should be drawn in
%% * label: a label for the angle (like $\theta$ or $\frac{5 \pi}{6}$
%% * distance: how far from the origin the little arc/spiral for the angle
%%   should start
%% * labelpos: how far along the arc the label should be drawn (0.5 by
%%   default) 
%% * func: Can be sin or cos; if set, draws a dotted horizontal (for cos) or
%%   vertical (for sin) line to indicate the trig value
%% * functick: a label for the dotted line
%% * triangle: Set to true to draw the reference triangle
%% * refangledistance: The analog of distance, but for the reference
%%   angle.
%% * secondangle, secondcolor, secondlabel, seconddistance,
%%   secondlabelpos: if you want to draw a second angle in the same
%%   picture

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{tikzangle}

\RequirePackage{environ}
\RequirePackage{tikz}

\makeatletter

\newcommand{\tikzangle@angle}{pi/4}
\newcommand{\tikzangle@distance}{auto}
\newcommand{\tikzangle@label}{}
\newcommand{\tikzangle@labelpos}{0.5}
\newcommand{\tikzangle@start}{0.1}
\newcommand{\tikzangle@color}{red}
\newcommand{\tikzangle@func}{none}
\newcommand{\tikzangle@functick}{auto}
\newcommand{\tikzangle@xtick}{auto}
\newcommand{\tikzangle@ytick}{auto}
\newcommand{\tikzangle@xticklabels}{auto}
\newcommand{\tikzangle@yticklabels}{auto}
\newcommand{\tikzangle@secondangle}{none}
\newcommand{\tikzangle@secondlabelpos}{0.5}
\newcommand{\tikzangle@seconddistance}{auto}
\newcommand{\tikzangle@triangle}{false}
\newcommand{\tikzangle@trianglecolor}{green!70!black}
\newcommand{\tikzangle@refangledistance}{8pt}

\pgfkeys{/tikzangle/.cd,% to set the path
  angle/.initial=0.1,
  angle/.store in=\tikzangle@angle,
  angle/.get=\tikzangle@angle,
  color/.initial=red,
  color/.store in=\tikzangle@color,
  color/.get=\tikzangle@color,
  label/.initial=,
  label/.store in=\tikzangle@label,
  label/.get=\tikzangle@label,
  labelpos/.initial=0.5,
  labelpos/.store in=\tikzangle@labelpos,
  labelpos/.get=\tikzangle@labelpos,
  distance/.initial=auto,
  distance/.store in=\tikzangle@distance,
  distance/.get=\tikzangle@distance,
  func/.initial=none,
  func/.store in=\tikzangle@func,
  func/.get=\tikzangle@func,
  functick/.initial=auto,
  functick/.store in=\tikzangle@functick,
  functick/.get=\tikzangle@functick,
  xtick/.initial=auto,
  xtick/.store in=\tikzangle@xtick,
  xtick/.get=\tikzangle@xtick,
  ytick/.initial=auto,
  ytick/.store in=\tikzangle@ytick,
  ytick/.get=\tikzangle@ytick,
  xticklabels/.initial=auto,
  xticklabels/.store in=\tikzangle@xticklabels,
  xticklabels/.get=\tikzangle@xticklabels,
  yticklabels/.initial=auto,
  yticklabels/.store in=\tikzangle@yticklabels,
  yticklabels/.get=\tikzangle@yticklabels,
  secondangle/.initial=none,
  secondangle/.store in=\tikzangle@secondangle,
  secondangle/.get=\tikzangle@secondangle,  
  secondcolor/.initial=blue,
  secondcolor/.store in=\tikzangle@secondcolor,
  secondcolor/.get=\tikzangle@secondcolor,
  secondlabel/.initial=,
  secondlabel/.store in=\tikzangle@secondlabel,
  secondlabel/.get=\tikzangle@secondlabel,
  seconddistance/.initial=auto,
  seconddistance/.store in=\tikzangle@seconddistance,
  seconddistance/.get=\tikzangle@seconddistance,
  secondlabelpos/.initial=0.5,
  secondlabelpos/.store in=\tikzangle@secondlabelpos,
  secondlabelpos/.get=\tikzangle@secondlabelpos,
  triangle/.initial=false,
  triangle/.store in=\tikzangle@triangle,
  triangle/.get=\tikzangle@triangle,
  trianglecolor/.initial=green!70!black,
  trianglecolor/.store in=\tikzangle@trianglecolor,
  trianglecolor/.get=\tikzangle@trianglecolor,
  refangledistance/.initial=8pt,
  refangledistance/.store in=\tikzangle@refangledistance,
  refangledistance/.get=\tikzangle@refangledistance,  
}

\newcommand{\@tikzanglecommand}[2][]{%
  \pgfqkeys{/pgfplots}{remainingkeys/.style={}}%
  \pgfqkeys{/tikzangle}{%
    % save unknown keys in /pgfplots/remainingkeys; code from
    % http://tex.stackexchange.com/questions/22952/how-do-you-pass-unknown-keys-as-options-to-a-tikz-picture
    .unknown/.code={%
      \let\currname\pgfkeyscurrentname%
      \let\currval\pgfkeyscurrentvalue%
      \ifx#1\pgfkeysnovalue%
      \pgfqkeys{/pgfplots}{remainingkeys/.append style/.expand once={\currname}}%
      \else%
      \pgfqkeys{/pgfplots}{remainingkeys/.append style/.expand twice={\expandafter\currname\expandafter=\currval}}%
      \fi%
    },%
    #1}%
  % 
    \begin{tikzpicture}
      [funcline/.style = {dotted, black!33!white},
      funcxtick/.style = {left, xshift=-1pt, fill=white, inner sep=1pt,
        font=\footnotesize}, 
      funcytick/.style = {below, yshift=-1pt, fill=white, inner sep=1pt,
        font=\footnotesize}, 
      ]
      \pgfmathsetmacro{\angle}{\tikzangle@angle}
      \pgfmathsetmacro{\px}{cos(deg(\angle))}
      \pgfmathsetmacro{\py}{sin(deg(\angle))}
      \pgfmathsetmacro{\anchor}{deg(\angle)*\tikzangle@labelpos + 180}
      % set ticks
      \ifthenelse{\equal{\tikzangle@xtick}{auto}}{
        \ifthenelse{\equal{\tikzangle@func}{cos}}{          
          \renewcommand{\tikzangle@xtick}{{\px}}
          \renewcommand{\tikzangle@xticklabels}{{}}
        }{
          \renewcommand{\tikzangle@xtick}{\empty}
        }
      }{
        % otherwise, user set xtick, leave as is
      }
      \ifthenelse{\equal{\tikzangle@xticklabels}{auto}}{
        \renewcommand{\tikzangle@xticklabels}{\tikzangle@xtick}
      }{
        % otherwise, user set
      }
      \ifthenelse{\equal{\tikzangle@ytick}{auto}}{
        \ifthenelse{\equal{\tikzangle@func}{sin}}{          
          \renewcommand{\tikzangle@ytick}{{\py}}
          \ifthenelse{\equal{\tikzangle@yticklabels}{auto}}
          {
            \renewcommand{\tikzangle@yticklabels}{{}}
          }{}
        }{
          \renewcommand{\tikzangle@ytick}{\empty}
        }
      }{
        % otherwise, user set ytick, leave as is
      }
      \ifthenelse{\equal{\tikzangle@yticklabels}{auto}}{
        \renewcommand{\tikzangle@yticklabels}{\tikzangle@ytick}
      }{
        % otherwise, user set
      }
      % show picture!
      \begin{axis}[xtick=\tikzangle@xtick, ytick=\tikzangle@ytick, xticklabels=\tikzangle@xticklabels, yticklabels=\tikzangle@yticklabels, axis equal=true, xmin=-1.1, xmax=1.1, ymin=-1.1, ymax=1.1, width=2in, height=2in, plot/.style={semithick}, clip=false, /pgfplots/remainingkeys]
        % if the angle is very small and the distance is at its default
        % value, set the distance further 
        \ifthenelse{\equal{\tikzangle@distance}{auto}}
        {\pgfmathsetmacro{\distance}{ifthenelse(abs(\angle)<pi/3, 0.11/abs(\angle), 0.1)}}
        {\pgfmathsetmacro{\distance}{\tikzangle@distance}}        

        % if angle is in [-2pi, 2pi], the angle is drawn as just an arc;
        % otherwise, it will be drawn as a spiral
        \pgfmathsetmacro{\expand}{ifthenelse(abs(\angle)>2*pi, 0.01 / \distance, 0)}
        
        \addplot+[domain=0:360] ({cos(x)}, {sin(x)}); %
        \ifthenelse{\equal{\tikzangle@triangle}{true}}{% draw reference
                                % triangle
          \pgfmathsetlengthmacro{\refanglestart}{\px/abs(\px)*\tikzangle@refangledistance}
          % where the reference angle should start and end; we do mod twice 
          % because it can give a negative result
          \pgfmathsetmacro{\endangle}{mod(mod(deg(\angle), 360) + 360, 360)}
          \pgfmathsetmacro{\startangle}{ifthenelse(and(90 < \endangle,
            \endangle < 270), 180, 0)}
          \pgfmathsetmacro{\startangle}{ifthenelse(\endangle > 270, 360,
            \startangle)}
          
          \draw[\tikzangle@trianglecolor, thick] (axis cs: 0, 0) -- (axis
          cs: \px, \py) -- (axis cs: \px, 0) -- cycle; %
          \draw[\tikzangle@trianglecolor] ($(axis cs: 0, 0) +
          (\refanglestart, 0)$) arc[radius=\tikzangle@refangledistance,
          start angle=\startangle, end angle=\endangle];
        }{ % don't draw reference triangle
          \draw[\tikzangle@color] (axis cs: 0, 0) -- (axis cs: \px,
          \py); %
        }%
        \ifthenelse{\equal{\tikzangle@secondangle}{none}}{}{
          \pgfmathsetmacro{\secondangle}{\tikzangle@secondangle}
          \pgfmathsetmacro{\qx}{cos(deg(\secondangle))}
          \pgfmathsetmacro{\qy}{sin(deg(\secondangle))}
          \pgfmathsetmacro{\secondanchor}{deg(\secondangle) *
            \tikzangle@secondlabelpos + 180}
          \ifthenelse{\equal{\tikzangle@seconddistance}{auto}}{
            \pgfmathsetmacro{\seconddistance}{%
              ifthenelse(abs(1.5 * \distance) < 0.11 / abs(\secondangle),
              0.11 / abs(\secondangle), 1.5 * \distance)} }{
            \pgfmathsetmacro{\seconddistance}{\tikzangle@seconddistance} }
          \pgfmathsetmacro{\secondexpand}{ifthenelse(abs(\secondangle)>2*pi,
            0.01 / \seconddistance, 0)}

          \draw[\tikzangle@secondcolor] (axis cs: 0, 0) -- (axis cs: \qx,
          \qy); %
          \addplot+[domain=0:\secondangle, \tikzangle@secondcolor, thin,
          ->, >=to] %
          ({\seconddistance * (1 + \secondexpand * abs(x)) * cos(deg(x))},
          {\seconddistance * (1 + \secondexpand * abs(x)) * sin(deg(x))})
          node[pos=\tikzangle@secondlabelpos, anchor=\secondanchor, inner
          sep=1pt]{\tikzangle@secondlabel}; %
        }
        \pgfmathsetmacro{\minuspx}{-\px}
        \pgfmathsetmacro{\minuspy}{-\py}
        \ifthenelse{\equal{\tikzangle@func}{sin}}{
          \draw[funcline] (axis cs: \px, \py) -- (axis cs: \minuspx, \py);
          \ifthenelse{\equal{\tikzangle@functick}{auto}}{%
            % try to automatically generate a label for the tick -
            % currently omitted because the precision is bad; instead,
            % draw nothing
            % \pgfkeys{/pgf/number format/frac shift=2}
            % \pgfkeys{/pgf/number format/frac}
            % \renewcommand{\tikzangle@functick}{\pgfmathprintnumber{\py}} 
          }{%
            \draw (axis cs: 0, \py) node[left, fill=white, inner sep=1pt,
            xshift=-1pt, font=\footnotesize]{\tikzangle@functick};
          }
        }{}
        \ifthenelse{\equal{\tikzangle@func}{cos}}{
          \draw[funcline] (axis cs: \px, \py) -- (axis cs:
          \px, \minuspy); 
          \ifthenelse{\equal{\tikzangle@functick}{auto}}{%
            % try to automatically generate a label for the tick -
            % currently omitted because the precision is bad; instead,
            % draw nothing
            % \pgfkeys{/pgf/number format/frac shift=2}
            % \pgfkeys{/pgf/number format/frac}
            % \renewcommand{\tikzangle@functick}{\pgfmathprintnumber{\px}} 
          }{
            \draw (axis cs: \px, 0) node[below, fill=white, inner sep=1pt,
            yshift=-1pt, font=\footnotesize]{\tikzangle@functick};
          }          
        }{}
        \addplot+[domain=0:\angle, \tikzangle@color, thin, ->, >=to]
        ({\distance * (1 + \expand * abs(x)) * cos(deg(x))}, %
         {\distance * (1 + \expand * abs(x)) * sin(deg(x))}) %
        node[pos=\tikzangle@labelpos, anchor=\anchor, inner
        sep=1pt]{\tikzangle@label}; %
        
      #2
      \end{axis}
    \end{tikzpicture}%    
}

\NewEnviron{tikzangle}[1][]{\@tikzanglecommand[#1]{\BODY}}

\newcommand{\@tikzcalibratedcirclecommand}[2][]{%
  \pgfqkeys{/pgfplots}{remainingkeys/.style={}}%
  \pgfqkeys{/tikzangle}{%
    % save unknown keys in /pgfplots/remainingkeys; code from
    % http://tex.stackexchange.com/questions/22952/how-do-you-pass-unknown-keys-as-options-to-a-tikz-picture
    .unknown/.code={%
      \let\currname\pgfkeyscurrentname%
      \let\currval\pgfkeyscurrentvalue%
      \ifx#1\pgfkeysnovalue%
      \pgfqkeys{/pgfplots}{remainingkeys/.append style/.expand once={\currname}}%
      \else%
      \pgfqkeys{/pgfplots}{remainingkeys/.append style/.expand twice={\expandafter\currname\expandafter=\currval}}%
      \fi%
    },%
    #1}%
  % 
  \begin{tikzpicture}
    \begin{axis}[minor xtick={-1, -0.9, ..., 1.01},
      minor ytick={-1, -0.9, ..., 1.01}, enlargelimits=false,
      axis line style={shorten >=-16pt, shorten <=-16pt},
      axis equal=true, grid=both, width=4in, height=4in, clip=false,
      xtick={-0.5, 0.5}, ytick={-0.5, 0.5}, /pgfplots/remainingkeys]
      \addplot+[domain=0:360] ({cos(x)}, {sin(x)});
      \addplot+[only marks, mark size=1pt, samples at={0.1, 0.2, ...,
        6.2}, black] ({cos(deg(x))}, {sin(deg(x))});
      \pgfplotsforeachungrouped \angle in {0.1, 0.3, ..., 6.1}
      {
        \pgfmathsetmacro{\x}{1.02 * cos(deg(\angle))}
        \pgfmathsetmacro{\y}{1.02 * sin(deg(\angle))}
        \pgfmathsetmacro{\anchor}{deg(\angle) + 180}
        \pgfmathroundto{\angle}
        
        \pgfkeys{/pgf/number format/precision=1}
        \edef\temp{\noexpand\draw (axis cs: \x, \y) node[fill=white,
          inner sep=0.5pt, anchor=\anchor] {\pgfmathresult}; %
        }%
        \temp
      }
      
      \pgfkeys{/pgf/number format/precision=2}
      #2
    \end{axis}
  \end{tikzpicture}%
}

\NewEnviron{tikzcalibratedcircle}[1][]{\@tikzcalibratedcirclecommand[#1]{\BODY}}

\makeatother

\ProcessOptions\relax
\endinput

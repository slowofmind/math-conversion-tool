\tikzset{mark size=1.5pt, mark options=thin}
\tikzset{pin distance=4pt,
  every pin edge/.style={<-, thin, shorten <= -2pt}}

\newcommand\resetstackedplots{
  \makeatletter
  \pgfplots@stacked@isfirstplottrue
  \makeatother
  \addplot [forget plot,draw=none] {0};
}       

\tikzset{
  hatch distance/.store in=\hatchdistance,
  hatch distance=6pt,
  hatch thickness/.store in=\hatchthickness,
  hatch thickness=0.4pt,
  hatch direction/.store in=\hatchdirection,
  hatch direction=1
}

\pgfdeclarepatternformonly[\hatchdistance,\hatchthickness,\hatchdirection]{flexible hatch}
{\pgfqpoint{0pt}{0pt}} %bottom left
{\pgfqpoint{\hatchdistance}{\hatchdistance}} % top right
{\pgfpoint{\hatchdistance-1pt}{\hatchdistance-1pt}} % tile size
{
  \pgfsetcolor{\tikz@pattern@color}
  \pgfsetlinewidth{\hatchthickness}
  \ifthenelse{\equal{\hatchdirection}{1}}{
    \pgfpathmoveto{\pgfqpoint{0pt}{0pt}}
    \pgfpathlineto{\pgfqpoint{\hatchdistance}{\hatchdistance}}
  }{
    \pgfpathmoveto{\pgfqpoint{\hatchdistance}{0pt}}
    \pgfpathlineto{\pgfpoint{-\hatchdistance}{2*\hatchdistance}}
  }
  \pgfusepath{stroke}
}  

% defines an anchor (by angle) that rotates with transforms
\tikzset{
  Anchor/.code=%
  \begingroup
  \pgfcoordinate{qrr@origin}{\pgfpointorigin}%
  \pgfcoordinate{qrr@direct}{\pgfpointpolarxy{#1}{1}}%
  \pgftransformreset
  \pgfmathanglebetweenpoints{\pgfpointanchor{qrr@origin}{center}}{\pgfpointanchor{qrr@direct}{center}}%
  \pgfmathsmuggle\pgfmathresult
  \endgroup
  \tikzset{anchor/.expanded=\pgfmathresult}%
}

\newcommand\rtheta[2]{{#1*cos(#2)},{#1*sin(#2)}}

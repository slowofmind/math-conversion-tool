% If blah is a string, \firstChar{blah} gives its first character. If
% blah is a command, it gives the command name as a string.
\def\@firstchar#1#2\EndMark{\string#1}
\newcommand{\firstChar}[1]{\@firstchar#1\EndMark}

\newcommand{\probspaceFirstChar}{Null}
\renewenvironment{problem}[1][0pt]{%
  \renewcommand{\probspace}{#1}%
  \renewcommand{\probspaceFirstChar}{\firstChar{#1}}%
}{%
  \pspace{\probspace}%
}
\let\nstretch=\stretch
\newcommand{\pspace}[1]{%
  % if \probspaceFirstChar is undefined (because \pspace was called
  % directly), define it
  \ifthenelse{\equal{\probspaceFirstChar}{Null}}%
  {\renewcommand{\probspaceFirstChar}{\firstChar{#1}}}%
  {}%
  % If the command is \vfill or \newpage, insert that
  % directly. Otherwise, see whether the command is \nstretch
  \ifthenelse{\equal{\probspaceFirstChar}{\firstChar{\vfill}}\OR\equal{\probspaceFirstChar}{\firstChar{\newpage}}}%
  {#1}%
  {\ifthenelse{\equal{\probspaceFirstChar}{\firstChar{\nstretch}}}%
    {\vspace{#1}\newpage}%
    {\vspace{#1}}}%
  \renewcommand{\probspaceFirstChar}{Null}%
}


{
  "name": "cm6-editor-bundle",
  "private": true,
  "version": "0.1.0",
  "description": "Builds codemirror/cm6-editor.js (the editor facade bundle) for the Accessible STEM conversion tool. See ../CM6-FACADE-DESIGN.md.",
  "type": "module",
  "scripts": {
    "build": "esbuild facade.js --bundle --format=esm --minify --target=es2020 --outfile=../codemirror/cm6-editor.js"
  },
  "dependencies": {
    "codemirror": "^6.0.1",
    "@codemirror/lint": "^6.8.0",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/legacy-modes": "^6.4.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}

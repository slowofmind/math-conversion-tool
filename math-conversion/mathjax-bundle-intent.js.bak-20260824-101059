var Ho={$schema:"./intent-vocabulary.schema.md",meta:{version:"0.3.0+bulk",updated:"2026-08-15",locales:["en"],status:"pipeline build from dginev/mathml-intent-open@016575a 2026-08-07; curated core + clean upstream imports (experimental)",v030:"Schema additions (2026-08-15): phrases may carry mid3/mid4/mid5 (arity up to 6, hard build error above); optional 'order' = permutation of the slot letters giving SPOKEN order for the SRE channel when it differs from visual order (emits ext-order; only the arity-2 swap 'ba' has a rule so far \u2014 others warn and fall back to visual order). The intent attribute is never reordered: slot-letter order is the W3C signature order. \\intent's first argument may carry colon properties (\\intent{power:silent}, \\intent{:function}) \u2014 properties ride the intent attribute only; property-only annotations emit no ext-*.",conceptNameSources:{mathcat:"Name taken verbatim from MathCAT Rules/Intent/*.yaml. Best available proxy for the eventual W3C open vocabulary, since MathCAT is the reference implementation. PREFER THESE.",w3c:"Name taken from W3C open/core vocabulary material.",coined:"Our own name. Expect to rename when the W3C vocabulary settles."},mathcatField:{infers:"MathCAT already gets this right unaided. Value of annotating is SRE-only. Tier 2.",wrong:"MathCAT infers something, but often the wrong thing. Annotating fixes BOTH channels. Tier 1.",absent:"MathCAT has no rule. Annotating fixes both channels. Tier 1."},notes:["arity is informational. Actual arity is counted from the \\iarg markers at parse time, so one entry serves whatever notation uses it.","macro.name must not duplicate another entry's macro.name \u2014 build-time error.","macro.name MAY shadow a package command (physics, ams, base): verified that config macros win in either load order. An author's own \\newcommand still beats ours, which is correct.","confidence flags an entry a subject-matter expert should review before use."],groups:{"core-authored":"The hand-authored core (34 as of 2026-08-09). Always enabled; toggles cannot turn it off.","algebra-arithmetic":"School/college algebra and arithmetic notation.","calculus-analysis":"Calculus and real/complex analysis.","linear-algebra":"Vectors, matrices, linear maps.","geometry-topology":"Geometry and topology.",discrete:"Combinatorics, graph theory, logic, computing.","number-theory":"Number theory.","probability-statistics":"Probability and statistics.","abstract-algebra-category":"Groups, rings, fields, categories.","special-functions":"Named special functions.","physics-quantum":"Physics incl. bra-ket / quantum notation beyond the core.","chemistry-units":"Chemistry notation and units.",other:"Everything the rollup map does not otherwise place."},groupNotes:`Rollup groups are the toggle surface (build-time flag and per-document intent-groups: metadata). Entries may also carry a fine-grained "area" (from the open-list importer) and "experimental": true. "mathcatName" records MathCAT's divergent name for the same concept where one exists (see docs/mathcat-vs-open-list-comparison.md); the build MATHCAT_NAMES switch selects which name the intent attribute carries.`},notations:[{id:"vbar-single",tex:"\\left| X \\right|",description:"one expression between vertical bars",concepts:["absolute-value","determinant","cardinality","magnitude","modulus"],mathcatBehaviour:"determinant if the content is an <mi> of only uppercase letters, else absolute-value. Controlled by ClearSpeak_AbsoluteValue (Auto | AbsEnd | Cardinality | Determinant); default Auto.",priority:"highest \u2014 |S| for set cardinality is read as 'determinant of S'"},{id:"dbar-single",tex:"\\left\\| X \\right\\|",description:"one expression between double vertical bars",concepts:["norm","magnitude"],mathcatBehaviour:"infers norm",priority:"low \u2014 MathCAT is right; SRE says 'the metric of'"},{id:"paren-pair",tex:"\\left( a, b \\right)",description:"two comma-separated expressions in parentheses",concepts:["open-interval","ordered-pair","gcd","point","cycle"],mathcatBehaviour:"infers open-interval",priority:"high \u2014 genuinely undecidable without the author; the canonical W3C example"},{id:"bracket-pair",tex:"\\left[ a, b \\right]",description:"two comma-separated expressions in square brackets",concepts:["closed-interval","commutator","matrix-row","equivalence-class"],mathcatBehaviour:"infers closed-interval",priority:"high"},{id:"angle-bar-angle",tex:"\\left\\langle a | b \\right\\rangle",description:"angle brackets with an internal vertical bar",concepts:["inner-product","braket","expectation-value","ket","bra"],mathcatBehaviour:"absent \u2014 no bra-ket inference",priority:"highest for physics \u2014 SRE reads the bar as the relation 'divides'"},{id:"bar-angle-angle-bar",tex:"\\left| a \\right\\rangle \\left\\langle b \\right|",description:"ket followed by bra: |a><b| outer product / projector",concepts:["ketbra"],mathcatBehaviour:"absent \u2014 no inference; symbols spoken",priority:"high for physics/QC \u2014 equal labels = projector; physics \\ketbra \\outerproduct \\dyad \\op all produce it; starred variants emit a FLAT token run (no wrapper mrow, non-stretchy bars)"},{id:"angle-bar-bar-angle",tex:"\\left\\langle m | A | n \\right\\rangle",description:"angle brackets with two internal vertical bars: matrix-element sandwich",concepts:["matrix-element","expectation-value"],mathcatBehaviour:"absent \u2014 SRE reads both bars as 'divides'; starred physics variants misread as absolute value",priority:"high for physics \u2014 <psi|A|psi> with equal labels is the expectation-value reading (author chooses); physics \\mel \\matrixelement and 2-arg \\expval produce it"},{id:"overline",tex:"\\overline{AB}",description:"a bar over one or more symbols",concepts:["complex-conjugate","line-segment","mean","set-complement","repeating-decimal"],mathcatBehaviour:"infers line-segment or repeating-decimal depending on content",priority:"high \u2014 five common readings"},{id:"superscript-T",tex:"X^{T}",description:"a capital T in the exponent position",concepts:["transpose","power"],mathcatBehaviour:"infers transpose",priority:"medium"},{id:"prime",tex:"f'",description:"prime mark",concepts:["derivative","prime-notation","transpose","set-complement"],mathcatBehaviour:"says 'prime'",priority:"medium"}],concepts:[{concept:"absolute-value",source:"mathcat",group:"core-authored",mathcat:"infers",tier:2,arity:1,notation:"vbar-single",confidence:"high",phrases:{en:{open:"the absolute value of",close:""}},macro:{name:"abs",args:1,tex:"\\left|\\iarg{#1}\\right|"},notes:"Shadows physics \\abs, deliberately. Same meaning, but ours emits intent."},{concept:"binomial-coefficient",source:"mathcat",group:"core-authored",mathcatName:"binomial",mathcat:"infers",tier:2,arity:2,notation:null,confidence:"high",phrases:{en:{open:"",mid1:"choose",close:""}},macro:{name:"binomc",args:2,tex:"\\binom{\\iarg{#1}}{\\iarg[b]{#2}}"},notes:`MathCAT calls this 'binomial'. REVIEW which spelling to keep; W3C material uses binomial-coefficient. MathCAT names this concept "binomial" (defs:19, "choose"); recorded per the mathcatName policy.`},{concept:"bra",source:"coined",group:"core-authored",mathcat:"absent",tier:1,arity:1,notation:"angle-bar-angle",confidence:"medium",phrases:{en:{open:"bra",close:""}},macro:null,notes:"DECIDED 2026-08-05. 'bra vector psi' attested ~8x (Susskind); IBM-Watrous 'read as bra a'. Medium not high: no other transcript voicing found; bras rarely voiced standalone. physics owns \\bra."},{concept:"braket",source:"coined",group:"core-authored",mathcat:"absent",tier:1,arity:2,notation:"angle-bar-angle",confidence:"medium",phrases:{en:{open:"the inner product of",mid1:"and",close:""}},macro:null,notes:"DECIDED 2026-08-05 (docs/braket-intent-recommendations.md): distinct concept name, spoken as inner product. Evidence: 'inner product of X with Y' dominant across Susskind/Adams/Shor transcripts; #90 thread converged on distinct bra/ket names (Ginev endorsed; B\xF6hm's final GitHub position). MathCAT channel speaks the name literally with comma separators: 'braket of a comma b' (verified live via NVDA 2026-08-05). Distinct from our inner-product entry (angle-comma notation). Fluent speech drops everything but labels ('phi psi') \u2014 noted, not implemented; terse layer later. Rename once W3C settles #90. physics owns \\braket/\\ip."},{concept:"cardinality",source:"mathcat",group:"core-authored",mathcat:"wrong",tier:1,arity:1,notation:"vbar-single",confidence:"high",phrases:{en:{open:"the cardinality of",close:""}},macro:{name:"card",args:1,tex:"\\left|\\iarg{#1}\\right|"},notes:"HIGHEST VALUE ENTRY. |S| for a set is read by MathCAT as 'determinant of S' because S is uppercase. Ubiquitous in discrete maths and set theory."},{concept:"cardinality-of-set-builder",source:"coined",group:"core-authored",mathcat:"absent",tier:3,arity:1,notation:null,confidence:"low",phrases:{en:{open:"the number of elements in",close:""}},macro:null,notes:"PLACEHOLDER. Probably redundant with cardinality; included only to record that the case was considered. Delete unless a reviewer wants it."},{concept:"clebsch-gordan-coefficient",source:"w3c",group:"physics-quantum",area:"special functions",mathcat:"absent",tier:1,arity:6,confidence:"medium",phrases:{en:{open:"the clebsch gordan coefficient for",mid1:",",mid2:",",mid3:",",mid4:",",mid5:",",close:""}},macro:{name:"clebschgordan",args:6,tex:"\\left\\langle \\iarg{#1}\\, \\iarg[b]{#2}\\, \\iarg[c]{#3}\\, \\iarg[d]{#4} \\,\\middle|\\, \\iarg[e]{#5}\\, \\iarg[f]{#6} \\right\\rangle"},notes:'Angle-bracket <j1 m1 j2 m2 | J M> form. FIRST ARITY-6 ENTRY (2026-08-15) \u2014 exercises ext-mid4/mid5 and the intent-arity6 rule; the sole arity-6 record in the open list. List speech is comma-separated ("clebsch-gordan coefficient for $jone, $jtwo, $mone, $mtwo, $j, $m"); commas kept as mid phrases. Physics reviewer should confirm the six-slot mapping for the <j1 m1 j2 m2|J M> vs (j1 j2 m1 m2|j1 j2 j m) notational variants. Refs MathWorld/Wikipedia/DLMF 34.1/nLab.'},{concept:"closed-interval",source:"mathcat",group:"core-authored",mathcat:"infers",tier:2,arity:2,notation:"bracket-pair",confidence:"high",phrases:{en:{open:"the closed interval from",mid1:"to",close:""}},macro:{name:"closedint",args:2,tex:"\\left[\\iarg{#1},\\iarg[b]{#2}\\right]"}},{concept:"closed-open-interval",source:"mathcat",group:"core-authored",mathcat:"infers",tier:2,arity:2,notation:"bracket-pair",confidence:"high",phrases:{en:{open:"the interval from",mid1:"inclusive to",close:"exclusive"}},macro:{name:"clopint",args:2,tex:"\\left[\\iarg{#1},\\iarg[b]{#2}\\right)"}},{concept:"complex-conjugate",source:"mathcat",group:"core-authored",mathcat:"wrong",tier:1,arity:1,notation:"overline",confidence:"high",phrases:{en:{open:"the complex conjugate of",close:""}},macro:{name:"conj",args:1,tex:"\\overline{\\iarg{#1}}"},notes:"MathCAT infers line-segment for an overline over two capitals, so complex conjugate of AB is misread. The canonical W3C example of this ambiguity."},{concept:"concentration",source:"w3c",group:"chemistry-units",mathcat:"absent",tier:1,arity:1,confidence:"high",phrases:{en:{open:"the concentration of",close:""}},macro:null,notes:'[X] molar concentration. From the intent-editor open list (chemistry area, arity 1, list phrase "concentration of"; we add "the" per house style). Collides with interval/matrix brackets. Adopted 2026-08-09 ahead of the bulk merge. First non-experimental chemistry entry.'},{concept:"cross-product",source:"mathcat",group:"core-authored",mathcat:"infers",tier:2,arity:2,notation:null,confidence:"high",phrases:{en:{open:"the cross product of",mid1:"and",close:""}},macro:{name:"crossp",args:2,tex:"\\iarg{#1}\\times\\iarg[b]{#2}"}},{concept:"definite-integral",source:"coined",group:"core-authored",mathcat:"absent",tier:1,arity:3,notation:null,confidence:"medium",phrases:{en:{open:"the integral from",mid1:"to",mid2:"of",close:""}},macro:{name:"defint",args:4,tex:"\\int_{\\iarg{#1}}^{\\iarg[b]{#2}}\\iarg[c]{#3}\\,d#4"},notes:"Four macro arguments but arity 3: the differential variable #4 is presentational only and is not an intent slot. REVIEW whether it should be."},{concept:"derivative",source:"coined",group:"core-authored",mathcat:"absent",tier:1,arity:2,notation:"prime",confidence:"medium",phrases:{en:{open:"the derivative of",mid1:"with respect to",close:""}},macro:{name:"deriv",args:2,tex:"\\frac{d\\iarg{#1}}{d\\iarg[b]{#2}}"},notes:"MathCAT has calculus rules for nabla forms but not for d/dx. REVIEW against MathCAT Rules/Intent/calculus.yaml before finalising."},{concept:"determinant",source:"mathcat",group:"core-authored",mathcat:"infers",tier:2,arity:1,notation:"vbar-single",confidence:"high",phrases:{en:{open:"the determinant of",close:""}},macro:{name:"determ",args:1,tex:"\\left|\\iarg{#1}\\right|"},notes:"MathCAT infers this for an uppercase <mi>. Annotating still helps SRE, and removes reliance on a typographic guess."},{concept:"dot-product",source:"mathcat",group:"core-authored",mathcat:"infers",tier:2,arity:2,notation:null,confidence:"high",phrases:{en:{open:"the dot product of",mid1:"and",close:""}},macro:{name:"dotp",args:2,tex:"\\iarg{#1}\\cdot\\iarg[b]{#2}"}},{concept:"expectation-value",source:"w3c",group:"core-authored",mathcat:"absent",tier:1,arity:1,notation:"angle-bar-angle",confidence:"high",phrases:{en:{open:"the expectation value of",mid1:"in the state",close:""}},macro:null,notes:"W3C open list has this exact name+notation (arity 1, 'expectation value of $1', area quantum physics). Arity here is informational: authored with a second \\iarg (the \\expval{A}{psi} form, <psi|A|psi>), mid1 engages: 'the expectation value of A in the state psi' \u2014 verbatim instructor-endorsed (Adams 8.04 L4, answering a pronunciation question). Fluent alternative 'psi A psi' noted, not implemented. Distinct from probability's expected-value E(X). physics owns \\expval/\\ev."},{concept:"fixed-point",source:"coined",group:"calculus-analysis",mathcat:"absent",tier:1,arity:1,confidence:"medium",phrases:{en:{open:"the fixed point",close:""}},macro:null,notes:"x^* as equilibrium of a dynamical system (APMTH 108 / Strogatz). Same notation means optimal-solution in optimization \u2014 the star is course-dependent; suggest tool must offer both. Authored 2026-08-09, coined per 5.7 shortcut."},{concept:"gcd",source:"mathcat",group:"core-authored",mathcat:"wrong",tier:1,arity:2,notation:"paren-pair",confidence:"medium",phrases:{en:{open:"the greatest common divisor of",mid1:"and",close:""}},macro:{name:"gcdof",args:2,tex:"\\gcd\\left(\\iarg{#1},\\iarg[b]{#2}\\right)"},notes:"Only ambiguous in the bare (a,b) form used in number theory. With an explicit \\gcd both engines are fine, so the macro spells it out."},{concept:"gradient",source:"coined",group:"calculus-analysis",mathcat:"absent",tier:1,arity:1,confidence:"medium",phrases:{en:{open:"the gradient of",close:""}},macro:null,notes:"\\nabla f. Open list has NO gradient entry (verified 2026-08-09); nabla is also divergence/curl/covariant-derivative depending on context, so no macro \u2014 wrap explicitly. Coined per 5.7 shortcut."},{concept:"hypergeometric-function",source:"w3c",group:"special-functions",area:"special functions",mathcat:"absent",tier:1,arity:4,confidence:"high",phrases:{en:{open:"the hypergeometric function of",mid1:",",mid2:",",mid3:"and",close:""}},macro:{name:"hypergeom",args:4,tex:"{}_{2}F_{1}\\left(\\iarg{#1},\\iarg[b]{#2};\\iarg[c]{#3};\\iarg[d]{#4}\\right)"},notes:'2F1(a,b;c;z). FIRST ARITY-4 ENTRY (2026-08-15) \u2014 exercises ext-mid3 and the intent-arity4 rule. Open-list signature hypergeometric-function($a,$b,$c,$value), speech "hypergeometric function of $a, $b, $c and $value"; property: function. Alias gauss-hypergeometric-function. Ref Wikipedia Hypergeometric_function.'},{concept:"inner-product",source:"mathcat",group:"core-authored",mathcat:"absent",tier:1,arity:2,notation:"angle-bar-angle",confidence:"high",phrases:{en:{open:"the inner product of",mid1:"and",close:""}},macro:{name:"ipof",args:2,tex:"\\left\\langle\\iarg{#1},\\iarg[b]{#2}\\right\\rangle"},notes:"physics has \\ip / \\innerproduct; ours is named ipof to leave those alone since their bracket style differs."},{concept:"ket",source:"coined",group:"core-authored",mathcat:"absent",tier:1,arity:1,notation:"angle-bar-angle",confidence:"high",phrases:{en:{open:"ket",close:""}},macro:null,notes:"DECIDED 2026-08-05. Ket-first order: Wikipedia explicit ('pronounce it ket-A'), Zwiebach/Susskind transcripts, IBM-Watrous ('read as ket a'), German/French parallel; label-first 'psi ket' unattested anywhere. Fluent speech drops 'ket' ('the state psi') \u2014 noted, not implemented. No macro \u2014 physics owns \\ket."},{concept:"ketbra",source:"coined",group:"core-authored",mathcat:"absent",tier:1,arity:2,notation:"bar-angle-angle-bar",confidence:"medium",phrases:{en:{open:"the outer product of",mid1:"and",close:""}},macro:null,notes:"DECIDED 2026-08-05. |psi><phi|. Spoken as outer product: Susskind 'the outer product of the ket vector B with the bra vector A'; Azure 'the ketbra or outer product'. 'dyad' is attested second choice (Susskind), not used. Equal-labels case is a projector ('projector onto psi') \u2014 future enhancement, noted. MathCAT literal fallback: 'ketbra of a comma b' (verified live 2026-08-05). Distinct from W3C outer-product (X\u2297Y infix). physics owns \\ketbra/\\outerproduct/\\dyad/\\op."},{concept:"lie-derivative",source:"w3c",group:"geometry-topology",area:"differential geometry",mathcat:"absent",tier:1,arity:2,confidence:"high",order:["b","a"],phrases:{en:{open:"the lie derivative of",mid1:"along",close:""}},macro:{name:"liederiv",args:2,tex:"\\mathcal{L}_{\\iarg{#1}}\\iarg[b]{#2}"},notes:'L_X Y. FIRST REORDER ENTRY (2026-08-15): open-list signature is lie-derivative($vector,$tensor) in visual order, but speech is "lie derivative of $tensor along $vector" \u2014 order:[b,a] emits ext-order="ba" so the SRE channel speaks the tensor first while the intent expression keeps signature order. Open list: differential geometry; refs Wikipedia/MathWorld/nLab Lie derivative.'},{concept:"line-segment",source:"mathcat",group:"core-authored",mathcat:"infers",tier:2,arity:1,notation:"overline",confidence:"high",phrases:{en:{open:"the line segment",close:""}},macro:{name:"lineseg",args:1,tex:"\\overline{\\iarg{#1}}"}},{concept:"magnitude",source:"mathcat",group:"core-authored",mathcat:"infers",tier:2,arity:1,notation:"vbar-single",confidence:"medium",phrases:{en:{open:"the magnitude of",close:""}},macro:{name:"magn",args:1,tex:"\\left|\\iarg{#1}\\right|"},notes:"MathCAT has a vector-magnitude rule but |v| lowercase falls through to absolute-value. Review: is 'magnitude' or 'absolute value' wanted for vectors in your courses?"},{concept:"matrix-element",source:"coined",group:"core-authored",mathcat:"absent",tier:1,arity:3,notation:"angle-bar-bar-angle",confidence:"high",phrases:{en:{open:"the matrix element",mid1:"",mid2:"",close:""}},macro:null,notes:"DECIDED 2026-08-05. <m|A|n>, args in written order (bra label, operator, ket label) -> 'the matrix element m A n'. Evidence: Susskind names it 'matrix element of K between vector B and vector A' and fluently reads bare 'n K r'; corpus supports 'matrix element of A between states m and n'. Rejected reordering template ('of $2 between $1 and $3') \u2014 moves args away from notation and every attested reading. Equal-labels case = expectation value (author's choice which intent fits). Within #90's 'maybe others'. physics owns \\mel/\\matrixelement."},{concept:"mean",source:"coined",group:"core-authored",mathcat:"wrong",tier:1,arity:1,notation:"overline",confidence:"medium",phrases:{en:{open:"the mean of",close:""}},macro:{name:"meanof",args:1,tex:"\\overline{\\iarg{#1}}"},notes:"x-bar in statistics. REVIEW spoken form: 'x bar' is what many statistics courses actually say aloud."},{concept:"modulus",source:"coined",group:"core-authored",mathcat:"wrong",tier:1,arity:1,notation:"vbar-single",confidence:"low",phrases:{en:{open:"the modulus of",close:""}},macro:{name:"modulus",args:1,tex:"\\left|\\iarg{#1}\\right|"},notes:"Complex modulus. REVIEW: many courses simply say 'absolute value' for this; may be redundant with absolute-value. Also collides conceptually with modular arithmetic 'mod'."},{concept:"norm",source:"mathcat",group:"core-authored",mathcat:"infers",tier:2,arity:1,notation:"dbar-single",confidence:"high",phrases:{en:{open:"the norm of",close:""}},macro:{name:"norm",args:1,tex:"\\left\\|\\iarg{#1}\\right\\|"},notes:"Shadows physics \\norm, deliberately. SRE alone says 'the metric of', which is wrong."},{concept:"open-closed-interval",source:"mathcat",group:"core-authored",mathcat:"infers",tier:2,arity:2,notation:"paren-pair",confidence:"high",phrases:{en:{open:"the interval from",mid1:"exclusive to",close:"inclusive"}},macro:{name:"opclint",args:2,tex:"\\left(\\iarg{#1},\\iarg[b]{#2}\\right]"}},{concept:"open-interval",source:"mathcat",group:"core-authored",mathcat:"infers",tier:2,arity:2,notation:"paren-pair",confidence:"high",phrases:{en:{open:"the open interval from",mid1:"to",close:""}},macro:{name:"openint",args:2,tex:"\\left(\\iarg{#1},\\iarg[b]{#2}\\right)"}},{concept:"optimal-solution",source:"coined",group:"other",mathcat:"absent",tier:1,arity:1,confidence:"medium",phrases:{en:{open:"the optimal solution",close:""}},macro:null,notes:"x^* as the optimizer (APMTH 121 / LP, Chvatal). Counterpart of fixed-point on the same notation. Authored 2026-08-09, coined per 5.7 shortcut."},{concept:"ordered-pair",source:"w3c",group:"core-authored",mathcat:"wrong",tier:1,arity:2,notation:"paren-pair",confidence:"high",phrases:{en:{open:"the ordered pair",mid1:"comma",close:""}},macro:{name:"pair",args:2,tex:"\\left(\\iarg{#1},\\iarg[b]{#2}\\right)"},notes:"MathCAT reads (a,b) as an open interval. Wrong whenever it is a point or a tuple \u2014 very common in coordinate geome